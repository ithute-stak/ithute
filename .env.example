# Standalone Ithute production configuration.
# Copy to .env.production on the VPS and keep it out of Git.

# Public IPv4 used by Ithute web/mail and authoritative DNS. Both registrar
# glue hosts ns1.ithute.co.ls and ns2.ithute.co.ls currently point here.
ITHUTE_PUBLIC_IPV4=204.12.205.224

ITHUTE_AUTH_ISSUER=https://auth.ithute.co.ls
ITHUTE_AUTH_ACCOUNT_BASE_URL=https://auth.ithute.co.ls
ITHUTE_REALTIME_PUBLIC_URL=https://realtime.ithute.co.ls

ITHUTE_AUTH_DB_NAME=ithute_auth
ITHUTE_AUTH_DB_USER=ithute_auth
ITHUTE_AUTH_DB_PASSWORD=
ITHUTE_PUSH_DB_NAME=ithute_push
ITHUTE_PUSH_DB_USER=ithute_push
ITHUTE_PUSH_DB_PASSWORD=
ITHUTE_REALTIME_DB_NAME=ithute_realtime
ITHUTE_REALTIME_DB_USER=ithute_realtime
ITHUTE_REALTIME_DB_PASSWORD=

ITHUTE_AUTH_TOTP_ENCRYPTION_KEY=
ITHUTE_PUSH_ENDPOINT_ENCRYPTION_KEY=
ITHUTE_SERVICE_REALTIME_SECRET=

# The fresh bootstrap fixes the owner email and requests the password securely.
ITHUTE_SYSTEM_OWNER_EMAIL=thekoetlisi@ithute.co.ls
ITHUTE_SYSTEM_OWNER_PASSWORD=

# Realtime is the only internal service client required by the clean platform.
ITHUTE_AUTH_FIRST_PARTY_CLIENTS=ithute-realtime:!thute Realtime
ITHUTE_AUTH_SERVICE_CLIENT_SECRETS_JSON={}
ITHUTE_AUTH_REDIRECT_URIS_JSON={}
ITHUTE_AUTH_CORS_ORIGINS=https://ithute.co.ls,https://auth.ithute.co.ls

# External products are opt-in. Keep these empty in the clean deployment.
ITHUTE_PUSH_ALLOWED_USER_CLIENTS=
ITHUTE_PUSH_ALLOWED_SERVICE_CLIENTS=ithute-realtime
ITHUTE_PUSH_DELEGATED_SERVICE_CLIENTS=ithute-realtime
ITHUTE_PUSH_ALLOWED_ADMIN_CLIENTS=
ITHUTE_REALTIME_ALLOWED_USER_CLIENTS=
ITHUTE_REALTIME_ALLOWED_SERVICE_CLIENTS=

# Push can start without an external provider on a fresh server.
# Set this to fcm only after the Firebase credential is installed.
ITHUTE_PUSH_REQUIRED_PROVIDERS=
ITHUTE_PUSH_FCM_PROJECT_ID=
ITHUTE_PUSH_FCM_ANDROID_CHANNEL_ID=ithute_default

# Optional SMTP delivery for Auth recovery/verification.
ITHUTE_AUTH_SMTP_HOST=
ITHUTE_AUTH_SMTP_PORT=587
ITHUTE_AUTH_SMTP_USERNAME=
ITHUTE_AUTH_SMTP_PASSWORD=
ITHUTE_AUTH_SMTP_FROM=
ITHUTE_AUTH_SMTP_STARTTLS=true

# Optional automatic mail-node VPS provisioning. Point this at an Ithute-compatible
# provider adapter (Proxmox, cloud provider, private infrastructure, etc.).
ITHUTE_MAIL_NODE_CONTROL_PLANE_URL=https://ithute.co.ls
ITHUTE_MAIL_NODE_PROVISIONER_URL=
ITHUTE_MAIL_NODE_PROVISIONER_TOKEN=
ITHUTE_MAIL_NODE_PROVISIONER_TIMEOUT_SECONDS=60

# Private/VPN CIDRs used by dedicated hosting nodes to hand healthy application
# origins to Ithute Edge. These must be routable from the Ithute API/Caddy host.
# Never include 0.0.0.0/0 or public customer networks.
ITHUTE_HOSTING_ORIGIN_CIDRS=10.70.0.0/24

# Ithute-managed private hosting network. The edge private key stays only on
# the edge host; only its public key is configured here.
ITHUTE_WIREGUARD_SUBNET=10.70.0.0/24
ITHUTE_WIREGUARD_EDGE_ADDRESS=10.70.0.1
ITHUTE_WIREGUARD_EDGE_PUBLIC_KEY=
ITHUTE_WIREGUARD_EDGE_ENDPOINT=
ITHUTE_WIREGUARD_LISTEN_PORT=51820
ITHUTE_WIREGUARD_RECONCILER_TOKEN=

# Hosting-node automatic activation and self-healing.
# The controller evaluates automated nodes every 30s, waits for sustained
# health before activation/recovery, and drains only new placement on failure.
ITHUTE_HOSTING_HEALTH_RECONCILE_SECONDS=30
ITHUTE_HOSTING_HEALTH_HEARTBEAT_SECONDS=180
ITHUTE_HOSTING_AUTO_ACTIVATE_SECONDS=120
ITHUTE_HOSTING_AUTO_DRAIN_SECONDS=60
ITHUTE_HOSTING_AUTO_RECOVER_SECONDS=180

# Automatic stateless application failover starts only after a node has remained
# auto-drained and unhealthy for this long. Stateful/manual projects are never
# relocated automatically.
ITHUTE_HOSTING_FAILOVER_AFTER_SECONDS=300

# Ithute specialist engines. Python/FastAPI remains authoritative.
# Rust and C++ libraries are compiled into the immutable app API image.
ITHUTE_RUST_CORE_LIBRARY=/opt/ithute-engines/libithute_rust_core.so
ITHUTE_CPP_NATIVE_LIBRARY=/opt/ithute-engines/libithute_cpp_native.so
# Go worker is built/published independently and will be enabled in the
# production topology only when its rollback-safe deployment phase lands.
ITHUTE_GO_WORKER_URL=http://ithute-go-worker:8080
# Java is the internal enterprise XML/report integration engine.
ITHUTE_JAVA_WORKER_URL=http://ithute-java-worker:8080
ITHUTE_ENGINE_HTTP_TIMEOUT_SECONDS=1.5
