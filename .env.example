# Mailbox-DNS commercial platform
APP_NAME=Mailbox DNS
ENVIRONMENT=development
PLATFORM_MODE=bootstrap
BOOTSTRAP_PUBLIC_IP=
CADDY_ADMIN_URL=http://caddy:2019
CADDY_RUNTIME_FILE=/platform-runtime/Caddyfile
SECRET_KEY=replace-with-a-long-random-secret
DKIM_ENCRYPTION_KEY=replace-with-a-separate-long-random-dkim-key
DKIM_ENCRYPTION_KEY_ID=v1
BILLING_WEBHOOK_SECRET=replace-with-a-separate-long-random-billing-webhook-secret
BILLING_GRACE_DAYS=7
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
INVITATION_EXPIRE_HOURS=72
EMAIL_VERIFICATION_EXPIRE_HOURS=24
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_COOKIE_NAME=mdns_access
REFRESH_COOKIE_NAME=mdns_refresh

# These become authoritative after the platform-domain activation wizard completes.
PANEL_HOSTNAME=panel.example.co.ls
API_HOSTNAME=api.example.co.ls
GROUPWARE_HOSTNAME=groupware.example.co.ls
ACME_EMAIL=ops@example.co.ls

POSTGRES_DB=lelefamail
POSTGRES_USER=lelefamail
POSTGRES_PASSWORD=replace-this-password
DATABASE_URL=postgresql+psycopg://lelefamail:replace-this-password@postgres:5432/lelefamail
REDIS_URL=redis://redis:6379/0
RSPAMD_REDIS_URL=redis://rspamd-redis:6379/0

# Central Ithute identity platform. These databases are deliberately separate
# from Mailbox-DNS and from every product database.
ITHUTE_AUTH_DB_NAME=ithute_auth
ITHUTE_AUTH_DB_USER=ithute_auth
ITHUTE_AUTH_DB_PASSWORD=replace-with-a-long-random-auth-db-password
ITHUTE_AUTH_ISSUER=https://auth.ithute.co.ls
ITHUTE_AUTH_ACCESS_TOKEN_MINUTES=10
ITHUTE_AUTH_REFRESH_TOKEN_DAYS=30
ITHUTE_AUTH_SERVICE_TOKEN_MINUTES=5
ITHUTE_AUTH_PUSH_USER_TOKEN_MINUTES=3
ITHUTE_AUTH_AUTHORIZATION_CODE_MINUTES=5
ITHUTE_AUTH_BROWSER_SESSION_HOURS=8
ITHUTE_AUTH_PASSWORD_RESET_MINUTES=30
ITHUTE_AUTH_VERIFICATION_CODE_MINUTES=10
ITHUTE_AUTH_RECOVERY_RATE_WINDOW_SECONDS=3600
ITHUTE_AUTH_RECOVERY_MAX_REQUESTS_PER_IP=20
ITHUTE_AUTH_RECOVERY_MAX_REQUESTS_PER_USER=5
ITHUTE_AUTH_VERIFICATION_RATE_WINDOW_SECONDS=3600
ITHUTE_AUTH_VERIFICATION_MAX_REQUESTS_PER_USER=6
ITHUTE_AUTH_VERIFICATION_CONFIRM_RATE_WINDOW_SECONDS=900
ITHUTE_AUTH_VERIFICATION_CONFIRM_MAX_FAILURES_PER_USER=10
ITHUTE_AUTH_MAX_LOGIN_FAILURES=5
ITHUTE_AUTH_LOGIN_LOCK_MINUTES=15
ITHUTE_AUTH_LOGIN_RATE_WINDOW_SECONDS=900
ITHUTE_AUTH_LOGIN_RATE_MAX_FAILURES_PER_IP=50
# Only trusted edge/proxy networks may supply X-Forwarded-For to Auth.
ITHUTE_AUTH_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
ITHUTE_AUTH_TOTP_ISSUER_NAME=!thute
# Required for MFA. Generate a Fernet key and store the production value only in secrets/runtime configuration.
ITHUTE_AUTH_TOTP_ENCRYPTION_KEY=
ITHUTE_AUTH_ACCOUNT_BASE_URL=https://auth.ithute.co.ls
# WebAuthn/passkey relying-party settings. Origin must match the browser's HTTPS origin.
ITHUTE_AUTH_WEBAUTHN_RP_ID=auth.ithute.co.ls
ITHUTE_AUTH_WEBAUTHN_RP_NAME=!thute
ITHUTE_AUTH_WEBAUTHN_ORIGIN=https://auth.ithute.co.ls
ITHUTE_AUTH_WEBAUTHN_CHALLENGE_MINUTES=5
ITHUTE_AUTH_JWT_KEY_ID=ithute-auth-2026-01
# Preserve retired public JWKs here during signing-key rollover until old tokens expire.
ITHUTE_AUTH_PREVIOUS_JWKS_JSON=[]
ITHUTE_AUTH_FIRST_PARTY_CLIENTS=loanhub:LoanHub,rsl-pos:RSL POS,mailbox-dns:Mailbox DNS,ithute-account:Ithute Account,ithute-tutor:Ithute Tutor,ithute-pay:Ithute Pay,ithute-realtime:!thute Realtime
# Tutor uses an exact OIDC callback. Add other product callbacks without removing Tutor.
ITHUTE_AUTH_REDIRECT_URIS_JSON={"ithute-tutor":["https://tutor.ithute.co.ls/api/auth/oidc/callback"]}
# Tutor's entry must match ITHUTE_TUTOR_PUSH_SERVICE_CLIENT_SECRET. Add other service clients at runtime.
ITHUTE_AUTH_SERVICE_CLIENT_SECRETS_JSON={"ithute-tutor":"replace-with-the-same-long-random-tutor-service-secret"}
ITHUTE_AUTH_CORS_ORIGINS=https://panel.ithute.co.ls,https://tutor.ithute.co.ls
# Auth lifecycle events are delivered to Push through a durable outbox worker.
ITHUTE_AUTH_PUSH_EVENTS_URL=http://ithute-push:8080/v1/internal/auth-events
ITHUTE_AUTH_PUSH_EVENT_WORKER_POLL_SECONDS=2
ITHUTE_AUTH_PUSH_EVENT_REQUEST_TIMEOUT_SECONDS=5
ITHUTE_AUTH_PUSH_EVENT_LEASE_SECONDS=30
# Central recovery / verification delivery.
ITHUTE_AUTH_SMTP_HOST=
ITHUTE_AUTH_SMTP_PORT=587
ITHUTE_AUTH_SMTP_USERNAME=
ITHUTE_AUTH_SMTP_PASSWORD=
ITHUTE_AUTH_SMTP_FROM=
ITHUTE_AUTH_SMTP_STARTTLS=true
ITHUTE_AUTH_SMS_WEBHOOK_URL=
ITHUTE_AUTH_SMS_WEBHOOK_TOKEN=

# Central Push platform.
ITHUTE_PUSH_DB_NAME=ithute_push
ITHUTE_PUSH_DB_USER=ithute_push
ITHUTE_PUSH_DB_PASSWORD=replace-with-a-long-random-push-db-password
# Must be a Fernet key. Production deployment generates this automatically.
ITHUTE_PUSH_ENDPOINT_ENCRYPTION_KEY=
ITHUTE_PUSH_ALLOWED_USER_CLIENTS=loanhub,rsl-pos,mailbox-dns,ithute-account,ithute-tutor,ithute-pay
ITHUTE_PUSH_ALLOWED_SERVICE_CLIENTS=loanhub,rsl-pos,mailbox-dns,ithute-account,ithute-tutor,ithute-pay,ithute-realtime
# Delegated publishing lets trusted platform services such as Realtime wake the
# correct product installation while preserving product-level endpoint isolation.
ITHUTE_PUSH_DELEGATED_SERVICE_CLIENTS=ithute-realtime
ITHUTE_PUSH_ALLOWED_ADMIN_CLIENTS=mailbox-dns
ITHUTE_PUSH_AUTH_CLOCK_SKEW_SECONDS=30
ITHUTE_PUSH_AUTH_MAX_PUSH_ACCESS_SECONDS=600
ITHUTE_PUSH_AUTH_MAX_SERVICE_TOKEN_SECONDS=600
ITHUTE_PUSH_AUTH_MAX_ADMIN_TOKEN_SECONDS=180
ITHUTE_PUSH_WORKER_POLL_SECONDS=2
ITHUTE_PUSH_MAX_ATTEMPTS=4
# Provider credentials stay blank until provisioned. Missing credentials fail
# delivery explicitly; the platform never records a fake successful push.
ITHUTE_PUSH_FCM_PROJECT_ID=
ITHUTE_PUSH_APNS_TEAM_ID=
ITHUTE_PUSH_APNS_KEY_ID=
ITHUTE_PUSH_APNS_BUNDLE_ID=
ITHUTE_PUSH_APNS_USE_SANDBOX=false
ITHUTE_PUSH_VAPID_SUBJECT=mailto:admin@ithute.co.ls
ITHUTE_PUSH_VAPID_PUBLIC_KEY=

# Central WebSocket/realtime/chat platform. It has its own PostgreSQL database
# and Redis; products access it only through Auth-protected APIs/WebSockets.
ITHUTE_REALTIME_DB_NAME=ithute_realtime
ITHUTE_REALTIME_DB_USER=ithute_realtime
ITHUTE_REALTIME_DB_PASSWORD=replace-with-a-long-random-realtime-db-password
ITHUTE_REALTIME_PUBLIC_URL=https://realtime.ithute.co.ls
ITHUTE_REALTIME_ALLOWED_USER_CLIENTS=loanhub,rsl-pos,mailbox-dns,ithute-account,ithute-tutor,ithute-pay
ITHUTE_REALTIME_ALLOWED_SERVICE_CLIENTS=loanhub,rsl-pos,mailbox-dns,ithute-account,ithute-tutor,ithute-pay
ITHUTE_REALTIME_PUSH_ENABLED=true
ITHUTE_REALTIME_WEBSOCKET_AUTH_TIMEOUT_SECONDS=10
ITHUTE_REALTIME_WEBSOCKET_PRESENCE_TTL_SECONDS=90
ITHUTE_REALTIME_MAX_MESSAGE_CHARS=4000
ITHUTE_REALTIME_MAX_GROUP_MEMBERS=100
ITHUTE_REALTIME_MAX_HISTORY_PAGE_SIZE=200
# Runtime-only service secret used by ithute-realtime to request short-lived Auth
# service tokens for delegated Push. Production deployment generates this once.
ITHUTE_SERVICE_REALTIME_SECRET=

# !thute Tutor product. Tutor has its own PostgreSQL database but uses central
# !thute Auth for identity and central !thute Push for device delivery.
ITHUTE_TUTOR_DB_NAME=ithute_tutor
ITHUTE_TUTOR_DB_USER=ithute_tutor
ITHUTE_TUTOR_DB_PASSWORD=replace-with-a-long-random-tutor-db-password
ITHUTE_TUTOR_PUBLIC_URL=https://tutor.ithute.co.ls
ITHUTE_TUTOR_FRONTEND_URL=https://tutor.ithute.co.ls
ITHUTE_TUTOR_OIDC_REDIRECT_URI=https://tutor.ithute.co.ls/api/auth/oidc/callback
ITHUTE_TUTOR_COOKIE_SECURE=true
ITHUTE_TUTOR_COOKIE_SAMESITE=lax
ITHUTE_TUTOR_LEGACY_AUTH_ENABLED=false
# Must equal the ithute-tutor entry in ITHUTE_AUTH_SERVICE_CLIENT_SECRETS_JSON.
ITHUTE_TUTOR_PUSH_SERVICE_CLIENT_SECRET=replace-with-the-same-long-random-tutor-service-secret
# Optional first deployment bootstrap. Use the immutable central Auth user sub UUID.
ITHUTE_TUTOR_BOOTSTRAP_AUTH_USER_ID=
ITHUTE_TUTOR_BOOTSTRAP_ADMIN_EMAIL=
ITHUTE_TUTOR_BOOTSTRAP_ADMIN_USERNAME=superadmin
# Loopback-only diagnostic ports; public traffic uses tutor.ithute.co.ls through Caddy.
ITHUTE_TUTOR_FRONTEND_PORT=3202
ITHUTE_TUTOR_BACKEND_PORT=8202
# Optional Tutor M-Pesa integration. The core product starts without these values.
ITHUTE_TUTOR_MPESA_API_KEY=
ITHUTE_TUTOR_MPESA_PUBLIC_KEY=
ITHUTE_TUTOR_MPESA_BASE_URL=
ITHUTE_TUTOR_MPESA_MARKET=
ITHUTE_TUTOR_MPESA_COUNTRY=LS
ITHUTE_TUTOR_MPESA_CURRENCY=LSL
ITHUTE_TUTOR_MPESA_SHORTCODE=
ITHUTE_TUTOR_MPESA_MODEL=

FRONTEND_PORT=3006
BACKEND_PORT=8006
PROXY_PORT=8086
FRONTEND_URL=http://localhost:3006
NEXT_PUBLIC_API_URL=http://localhost:8006/api/v1
BACKEND_WORKERS=4

# Public signup stays closed during bootstrap mode. After verified domain activation,
# signup is protected with fail-closed Redis rate limits and email verification.
SIGNUP_RATE_WINDOW_SECONDS=3600
SIGNUP_RATE_MAX_ATTEMPTS=20

# System email used for account verification and platform notifications.
# It can stay blank during raw-IP bootstrap because public customer signup is closed.
SYSTEM_EMAIL_FROM=
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USERNAME=
SYSTEM_SMTP_PASSWORD=
SYSTEM_SMTP_SSL=false
SYSTEM_SMTP_STARTTLS=true

NAMESERVER_1=ns1.example.co.ls
NAMESERVER_2=ns2.example.co.ls
DOMAIN_VERIFICATION_MIN_INTERVAL_SECONDS=10
DOMAIN_VERIFICATION_MAX_ATTEMPTS_PER_HOUR=20
POWERDNS_API_URL=http://powerdns:8081/api/v1
POWERDNS_API_KEY=replace-with-a-long-random-powerdns-api-key
POWERDNS_SERVER_ID=localhost
POWERDNS_API_TIMEOUT_SECONDS=5
POWERDNS_DEFAULT_TTL=3600
POWERDNS_DB_NAME=powerdns
POWERDNS_DB_USER=powerdns
POWERDNS_DB_PASSWORD=replace-with-a-strong-powerdns-db-password
DNS_PORT=53

MAIL_HOSTNAME=mail.example.co.ls
MAIL_PUBLIC_IP=
MAIL_TLS_MODE=selfsigned
SMTP_PORT=2525
SUBMISSION_PORT=2587
IMAP_PORT=2143
IMAPS_PORT=2993
MAIL_DATA_PATH=/srv/vmail
MAIL_OPS_URL=http://postfix:9080
MAIL_OPS_TOKEN=replace-with-a-long-random-mail-ops-token
MAIL_OPS_TIMEOUT_SECONDS=5

WEBMAIL_SESSION_COOKIE_NAME=mdns_webmail
WEBMAIL_SESSION_TTL_SECONDS=28800
WEBMAIL_IMAP_HOST=dovecot
WEBMAIL_IMAP_PORT=143
WEBMAIL_SMTP_HOST=postfix
WEBMAIL_SMTP_PORT=587
WEBMAIL_TRANSPORT_TIMEOUT_SECONDS=15
WEBMAIL_LOGIN_MAX_ATTEMPTS=8
WEBMAIL_LOGIN_WINDOW_SECONDS=900
WEBMAIL_LOGIN_LOCK_SECONDS=900

# Transactional email
TRANSACTIONAL_SMTP_HOST=postfix
TRANSACTIONAL_SMTP_PORT=587
TRANSACTIONAL_SMTP_VERIFY_TLS=false
TRANSACTIONAL_DEFAULT_DAILY_LIMIT=1000
TRANSACTIONAL_TENANT_DAILY_LIMIT=10000
TRANSACTIONAL_MAX_RECIPIENTS=100

# External commercial provider adapters. Credentials intentionally remain blank
# until the provider is enabled for production; adapters fail closed when absent.
EXTERNAL_PROVIDER_TIMEOUT_SECONDS=20
DPO_API_URL=https://secure.3gdirectpay.com/API/v6/
DPO_CHECKOUT_URL=https://secure.3gdirectpay.com/payv2.php?ID={token}
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
DPO_REDIRECT_URL=http://localhost:3006/billing
DPO_BACK_URL=http://localhost:8006/api/v1/payments/dpo/callback
DPO_PAYMENT_TIME_LIMIT_HOURS=48
OPENSRS_API_URL=https://rr-n1-tor.opensrs.net:55443/
OPENSRS_USERNAME=
OPENSRS_API_KEY=

# Groupware / CalDAV / CardDAV
GROUPWARE_PUBLIC_URL=http://localhost:5232
GROUPWARE_AUTH_FILE=/groupware-auth/users

# Backup / recovery
RESTIC_REPOSITORY=/repository
RESTIC_PASSWORD=replace-with-a-long-independent-backup-password
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=5
BACKUP_KEEP_MONTHLY=12
