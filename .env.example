# Ithute public edge
ITHUTE_WEB_IMAGE=ghcr.io/ithute-stak/ithute-web
ITHUTE_WEB_IMAGE_TAG=latest

# Transitional shared network used only to reach the already-running central
# Ithute Auth/Push/Realtime services. The edge never joins application networks.
ITHUTE_PLATFORM_NETWORK_NAME=mailbox-dns_mailbox_dns

# Existing TLS volumes are intentionally reused so certificate state is not lost.
ITHUTE_EDGE_LETSENCRYPT_VOLUME=loanhub_edge_letsencrypt
ITHUTE_EDGE_CERTBOT_WEBROOT_VOLUME=loanhub_edge_certbot_webroot

# Central platform public identity
ITHUTE_AUTH_ISSUER=https://auth.ithute.co.ls
ITHUTE_REALTIME_PUBLIC_URL=https://realtime.ithute.co.ls

# Required central platform secrets are supplied by the production environment,
# never committed here.
ITHUTE_AUTH_DB_PASSWORD=
ITHUTE_AUTH_TOTP_ENCRYPTION_KEY=
ITHUTE_PUSH_DB_PASSWORD=
ITHUTE_PUSH_ENDPOINT_ENCRYPTION_KEY=
ITHUTE_REALTIME_DB_PASSWORD=
ITHUTE_SERVICE_REALTIME_SECRET=
