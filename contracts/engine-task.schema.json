{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ithute.co.ls/contracts/engine-task.schema.json",
  "title": "Ithute Engine Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "task_id", "engine", "operation", "payload"],
  "properties": {
    "version": {"const": "1"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "engine": {"enum": ["python", "rust", "go", "cpp"]},
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "tenant_id": {"type": ["string", "null"], "format": "uuid"},
    "payload": {"type": "object"},
    "deadline_ms": {"type": ["integer", "null"], "minimum": 1, "maximum": 300000},
    "trace_id": {"type": ["string", "null"], "maxLength": 128}
  }
}
