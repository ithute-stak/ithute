{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ithute.co.ls/contracts/hardware-intelligence/telemetry-v1.schema.json",
  "title": "Ithute Hardware Intelligence Telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sampled_at_unix", "uptime_seconds", "load", "memory", "cpu", "thermal"],
  "properties": {
    "schema_version": {"const": 1},
    "sampled_at_unix": {"type": "integer", "minimum": 0},
    "uptime_seconds": {"type": "number", "minimum": -1},
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["one", "five", "fifteen"],
      "properties": {
        "one": {"type": "number", "minimum": 0},
        "five": {"type": "number", "minimum": 0},
        "fifteen": {"type": "number", "minimum": 0}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_kb", "available_kb", "swap_total_kb", "swap_free_kb"],
      "properties": {
        "total_kb": {"type": "integer", "minimum": 0},
        "available_kb": {"type": "integer", "minimum": 0},
        "swap_total_kb": {"type": "integer", "minimum": 0},
        "swap_free_kb": {"type": "integer", "minimum": 0}
      }
    },
    "cpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "nice", "system", "idle", "iowait", "irq", "softirq", "steal"],
      "properties": {
        "user": {"type": "integer", "minimum": 0},
        "nice": {"type": "integer", "minimum": 0},
        "system": {"type": "integer", "minimum": 0},
        "idle": {"type": "integer", "minimum": 0},
        "iowait": {"type": "integer", "minimum": 0},
        "irq": {"type": "integer", "minimum": 0},
        "softirq": {"type": "integer", "minimum": 0},
        "steal": {"type": "integer", "minimum": 0}
      }
    },
    "thermal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zones_seen", "max_celsius"],
      "properties": {
        "zones_seen": {"type": "integer", "minimum": 0},
        "max_celsius": {"type": "number"}
      }
    }
  }
}
