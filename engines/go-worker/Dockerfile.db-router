FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ithute-db-router ./cmd/db-router

FROM alpine:3.21
RUN addgroup -S ithute && adduser -S -G ithute ithute
COPY --from=build /out/ithute-db-router /usr/local/bin/ithute-db-router
USER ithute
ENTRYPOINT ["/usr/local/bin/ithute-db-router"]
