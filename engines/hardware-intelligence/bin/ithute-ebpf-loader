#!/usr/bin/env bash
set -euo pipefail

BPF_OBJECT="${ITHUTE_EBPF_OBJECT:-/opt/ithute/hardware-intelligence/ithute_observer.bpf.o}"
PIN_ROOT="${ITHUTE_EBPF_PIN_ROOT:-/sys/fs/bpf/ithute_hardware}"
RUN_DIR="${ITHUTE_EBPF_RUN_DIR:-/run/ithute-hardware}"
SNAPSHOT="${ITHUTE_EBPF_SNAPSHOT:-${RUN_DIR}/ebpf.json}"

die() {
  printf 'ithute-ebpf-loader: %s\n' "$*" >&2
  exit 2
}

require_root() {
  [ "$(id -u)" -eq 0 ] || die "this command must run as root or an equivalently constrained systemd service"
}

require_bpftool() {
  command -v bpftool >/dev/null 2>&1 || die "bpftool is required"
}

ensure_kernel_support() {
  [ -r /sys/kernel/btf/vmlinux ] || die "kernel BTF is unavailable"
  [ -d /sys/fs/bpf ] || die "BPF filesystem is unavailable"
}

start_programs() {
  require_root
  require_bpftool
  ensure_kernel_support
  [ -r "$BPF_OBJECT" ] || die "BPF object not found: $BPF_OBJECT"

  install -d -m 0755 "$PIN_ROOT" "$PIN_ROOT/programs" "$PIN_ROOT/maps" "$RUN_DIR"

  # Remove only Ithute-owned pins. Never mutate unrelated host BPF state.
  find "$PIN_ROOT/programs" -mindepth 1 -maxdepth 1 -type f -delete 2>/dev/null || true
  find "$PIN_ROOT/maps" -mindepth 1 -maxdepth 1 -type f -delete 2>/dev/null || true

  bpftool prog loadall "$BPF_OBJECT" "$PIN_ROOT/programs" pinmaps "$PIN_ROOT/maps" autoattach
  snapshot
}

snapshot() {
  require_root
  require_bpftool
  install -d -m 0755 "$RUN_DIR"

  local map_path="$PIN_ROOT/maps/event_counters"
  if [ ! -e "$map_path" ]; then
    printf '%s\n' '{"available":false,"reason":"event_counters map is not pinned"}' > "${SNAPSHOT}.tmp"
  else
    local raw hist stats
    raw="$(bpftool -j map dump pinned "$map_path" 2>/dev/null || printf '[]')"
    hist="$(bpftool -j map dump pinned "$PIN_ROOT/maps/block_latency_hist" 2>/dev/null || printf '[]')"
    stats="$(bpftool -j map dump pinned "$PIN_ROOT/maps/block_latency_stats" 2>/dev/null || printf '[]')"
    python3 - "$raw" "$hist" "$stats" > "${SNAPSHOT}.tmp" <<'PY'
import json
import math
import sys
import time

def load_arg(index):
    try:
        value = json.loads(sys.argv[index])
        return value if isinstance(value, list) else []
    except Exception:
        return []

def u64(raw):
    return int.from_bytes(bytes(raw[:8]), "little") if isinstance(raw, list) else 0

def percpu_sum(rows, expected):
    totals = [0] * expected
    for row in rows:
        key = row.get("key")
        values = row.get("values")
        if not isinstance(key, list) or len(key) < 4 or not isinstance(values, list):
            continue
        idx = int.from_bytes(bytes(key[:4]), "little")
        if not 0 <= idx < expected:
            continue
        total = 0
        for item in values:
            value = item.get("value") if isinstance(item, dict) else None
            total += u64(value)
        totals[idx] = total
    return totals

def percentile(histogram, upper_us, pct):
    total = sum(histogram)
    if total <= 0:
        return None
    target = math.ceil(total * pct)
    running = 0
    for count, upper in zip(histogram, upper_us):
        running += count
        if running >= target:
            return upper / 1000.0
    return None

events = percpu_sum(load_arg(1), 4)
histogram = percpu_sum(load_arg(2), 16)
stats_rows = load_arg(3)

latency_count = 0
latency_total_ns = 0
latency_max_ns = 0
for row in stats_rows:
    values = row.get("values")
    if not isinstance(values, list):
        continue
    for item in values:
        value = item.get("value") if isinstance(item, dict) else None
        if not isinstance(value, list) or len(value) < 24:
            continue
        latency_count += int.from_bytes(bytes(value[0:8]), "little")
        latency_total_ns += int.from_bytes(bytes(value[8:16]), "little")
        latency_max_ns = max(latency_max_ns, int.from_bytes(bytes(value[16:24]), "little"))

upper_us = [100,250,500,1000,2000,4000,8000,16000,32000,64000,128000,256000,512000,1000000,2000000,4000000]

print(json.dumps({
    "available": True,
    "sampled_at_unix": int(time.time()),
    "block_requests_issued": events[0],
    "block_requests_completed": events[1],
    "process_exits": events[2],
    "oom_victims": events[3],
    "block_latency_count": latency_count,
    "block_latency_avg_ms": round((latency_total_ns / latency_count) / 1_000_000, 3) if latency_count else None,
    "block_latency_max_ms": round(latency_max_ns / 1_000_000, 3) if latency_count else None,
    "block_latency_p50_ms": percentile(histogram, upper_us, 0.50),
    "block_latency_p95_ms": percentile(histogram, upper_us, 0.95),
    "block_latency_p99_ms": percentile(histogram, upper_us, 0.99),
    "block_latency_histogram": histogram,
}, separators=(",", ":")))
PY
  fi

  chown root:root "${SNAPSHOT}.tmp"
  chmod 0644 "${SNAPSHOT}.tmp"
  mv -f "${SNAPSHOT}.tmp" "$SNAPSHOT"
}

status_programs() {
  require_bpftool
  printf 'object=%s\npin_root=%s\nsnapshot=%s\n' "$BPF_OBJECT" "$PIN_ROOT" "$SNAPSHOT"
  if [ -e "$PIN_ROOT/maps/event_counters" ]; then
    printf 'state=loaded\n'
    bpftool prog show pinned "$PIN_ROOT/programs/ithute_block_issue" 2>/dev/null || true
  else
    printf 'state=not-loaded\n'
  fi
}

stop_programs() {
  require_root
  # Detaching happens when pinned auto-attached links/programs are removed.
  # Scope deletion strictly to Ithute's own pin tree.
  if [ -d "$PIN_ROOT" ]; then
    find "$PIN_ROOT" -depth -type f -delete 2>/dev/null || true
    find "$PIN_ROOT" -depth -type d -empty -delete 2>/dev/null || true
  fi
  rm -f "$SNAPSHOT"
}

case "${1:-}" in
  start) start_programs ;;
  snapshot) snapshot ;;
  status) status_programs ;;
  stop) stop_programs ;;
  *) die "usage: $0 {start|snapshot|status|stop}" ;;
esac
