[server]
hosts = 0.0.0.0:5232
max_connections = 20
timeout = 30

[auth]
type = htpasswd
htpasswd_filename = /auth/users
htpasswd_encryption = bcrypt
delay = 1

[rights]
type = owner_only

[storage]
filesystem_folder = /var/lib/radicale/collections
max_sync_token_age = 2592000

[logging]
level = info
mask_passwords = True
