# BEGIN ITHUTE TEMPORARY IP FALLBACK
# Temporary propagation bridge. This serves only the Ithute web frontend over
# plain HTTP on the production IPv4 while recursive DNS and ACME certificate
# state settle. Production deployment removes this block automatically after
# every public Ithute HTTPS endpoint is verified.
http://204.12.205.224 {
  header X-Ithute-Temporary-IP "true"
  header X-Ithute-Service "web"
  header X-Content-Type-Options "nosniff"
  header X-Frame-Options "DENY"
  header Referrer-Policy "strict-origin-when-cross-origin"
  reverse_proxy ithute-web:3000
}
# END ITHUTE TEMPORARY IP FALLBACK

ithute.co.ls {
  header X-Ithute-Service "web"
  header X-Content-Type-Options "nosniff"
  header X-Frame-Options "DENY"
  header Referrer-Policy "strict-origin-when-cross-origin"

  @app_api path /api/* /redoc /redoc/* /openapi.json /mail/config-v1.1.xml /.well-known/autoconfig/mail/config-v1.1.xml /autodiscover/autodiscover.xml
  handle @app_api {
    header X-Ithute-Service "app-api"
    reverse_proxy ithute-app-api:8000
  }

  handle {
    reverse_proxy ithute-web:3000
  }
}

www.ithute.co.ls {
  redir https://ithute.co.ls{uri} permanent
}

auth.ithute.co.ls {
  header X-Ithute-Service "auth"
  reverse_proxy ithute-auth:8080
}

push.ithute.co.ls {
  header X-Ithute-Service "push"
  reverse_proxy ithute-push:8080
}

realtime.ithute.co.ls {
  header X-Ithute-Service "realtime"
  reverse_proxy ithute-realtime:8080
}

loanhub.co.ls {
  header X-Ithute-Service "loanhub-web"
  header X-Content-Type-Options "nosniff"
  header X-Frame-Options "DENY"
  header Referrer-Policy "strict-origin-when-cross-origin"
  reverse_proxy loanhub-web:3000
}

www.loanhub.co.ls {
  redir https://loanhub.co.ls{uri} permanent
}

api.loanhub.co.ls {
  header X-Ithute-Service "loanhub-api"
  header X-Content-Type-Options "nosniff"
  header X-Frame-Options "DENY"
  header Referrer-Policy "strict-origin-when-cross-origin"
  reverse_proxy loanhub-api:8000
}
