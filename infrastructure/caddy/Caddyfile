{
	email {$ACME_EMAIL}
	admin off
}

# The Ithute apex is the one public frontend. www is canonicalized to the apex,
# and application/API paths share the same origin. There is intentionally no
# panel.ithute.co.ls site.
ithute.co.ls, www.ithute.co.ls {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	@www host www.ithute.co.ls
	redir @www https://ithute.co.ls{uri} permanent

	@api path /api/*
	handle @api {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

{$API_HOSTNAME} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}
	reverse_proxy backend:8000
}

{$GROUPWARE_HOSTNAME} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}
	reverse_proxy radicale:5232
}