# Public control plane. HTTPS is required outside local testing.
ITHUTE_API_URL=https://ithute.co.ls

# Dedicated upload hostname pointed to this isolated build-plane host.
ITHUTE_HOSTING_UPLOAD_HOST=upload.ithute.co.ls
ITHUTE_HOSTING_UPLOAD_ALLOWED_ORIGIN=https://ithute.co.ls

# One-time generated service credentials from the Ithute platform-owner APIs.
# Never commit populated values.
ITHUTE_HOSTING_UPLOAD_SERVICE_TOKEN=ith_upload_REPLACE_ME
ITHUTE_HOSTING_BUILDER_TOKEN=ith_build_REPLACE_ME

# Host paths prepared by bootstrap-host.sh.
ITHUTE_HOSTING_STORAGE_ROOT=/srv/ithute-hosting-build-plane
ITHUTE_HOSTING_BUILDER_KNOWN_HOSTS_FILE=/etc/ithute-hosting-builder/known_hosts
ITHUTE_HOSTING_DOCKER_CONFIG_ROOT=/etc/ithute-hosting-builder/docker

# Numeric group id that owns /var/run/docker.sock on THIS dedicated build host.
ITHUTE_HOSTING_DOCKER_GID=999

ITHUTE_HOSTING_BUILDER_POLL_SECONDS=15
ITHUTE_HOSTING_BUILDER_ALLOW_CUSTOM_DOCKERFILE=false
