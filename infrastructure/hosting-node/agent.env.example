# Control plane
ITHUTE_API_URL=https://ithute.co.ls
ITHUTE_HOSTING_AGENT_TOKEN=ith_host_REPLACE_ME
ITHUTE_HOSTING_POLL_SECONDS=15
ITHUTE_HOSTING_HEARTBEAT_SECONDS=60
ITHUTE_HOSTING_IMAGE_PREFIX=ghcr.io/ithute-stak/hosted-

# Every customer project receives a dedicated /28 from this private reserved pool.
# Keep this CIDR exclusive to Ithute hosted networks on the node.
ITHUTE_HOSTING_NETWORK_POOL=10.240.0.0/12
ITHUTE_HOSTING_NETWORK_PREFIX=28

# Database backups remain outside customer containers and writable only to the node agent.
ITHUTE_HOSTING_DATABASE_BACKUP_ROOT=/var/lib/ithute-hosting/database-backups
ITHUTE_HOSTING_DATABASE_BACKUP_MAX_BYTES=21474836480

# Production backups must also be replicated off-node. Configure any rclone-supported
# object/storage backend. Keep the real rclone.conf mode 0600 and outside Git.
ITHUTE_HOSTING_BACKUP_REMOTE_REQUIRED=true
ITHUTE_HOSTING_BACKUP_REMOTE=remote:ithute-hosting-backups/production
ITHUTE_HOSTING_RCLONE_CONFIG=/etc/ithute-hosting-node/rclone.conf
ITHUTE_HOSTING_RCLONE=rclone

# Shared PostgreSQL service. Keep the admin listener on loopback/private host interfaces only.
ITHUTE_HOSTING_POSTGRES_ADMIN_HOST=127.0.0.1
ITHUTE_HOSTING_POSTGRES_ADMIN_PORT=5432
ITHUTE_HOSTING_POSTGRES_ADMIN_USER=ithute_hosting_admin
ITHUTE_HOSTING_POSTGRES_ADMIN_PASSWORD=REPLACE_ME
ITHUTE_HOSTING_POSTGRES_ADMIN_DATABASE=postgres
ITHUTE_HOSTING_POSTGRES_HOST=ithute-db-gateway
ITHUTE_HOSTING_POSTGRES_PORT=5432

# Shared MySQL service. Keep the admin listener on loopback/private host interfaces only.
ITHUTE_HOSTING_MYSQL_ADMIN_HOST=127.0.0.1
ITHUTE_HOSTING_MYSQL_ADMIN_PORT=3306
ITHUTE_HOSTING_MYSQL_ADMIN_USER=ithute_hosting_admin
ITHUTE_HOSTING_MYSQL_ADMIN_PASSWORD=REPLACE_ME
ITHUTE_HOSTING_MYSQL_HOST=ithute-db-gateway
ITHUTE_HOSTING_MYSQL_PORT=3306

# Hosted workload egress. HTTPS/HTTP/DNS are allowed by default; everything else is rejected.
# Override the Docker host gateway only if Docker's default bridge gateway is not correct.
# ITHUTE_HOSTING_DB_GATEWAY_IP=172.17.0.1
ITHUTE_HOSTING_EGRESS_ALLOW_DNS=true
ITHUTE_HOSTING_EGRESS_ALLOW_HTTP=true
ITHUTE_HOSTING_EGRESS_ALLOW_HTTPS=true
