[Unit]
Description=Ithute managed hosting node agent
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=ithute-hosting-agent
Group=ithute-hosting-agent
SupplementaryGroups=docker
EnvironmentFile=/etc/ithute-hosting-node/agent.env
ExecStart=/usr/bin/python3 /opt/ithute-hosting-agent/agent_v4.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM

# The agent must reach Docker, the control plane and node-local DB clients, but
# it receives writable host filesystem access only for its scoped backup state.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ithute-hosting
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077

[Install]
WantedBy=multi-user.target
