        proxy_set_header X-Forwarded-Proto https;
    }
}

# Unknown HTTPS hostnames are rejected by the one and only TLS default server.
# This prevents accidental cross-product routing when a hostname is missing or
# temporarily misconfigured.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;
    include /etc/nginx/snippets/ithute-tls.conf;

    return 404;
}
