map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

resolver 127.0.0.11 ipv6=off valid=30s;

upstream ithute_web {
    server ithute-web:3000;
    keepalive 32;
}

upstream ithute_auth {
    server ithute-auth:8080;
    keepalive 16;
}

upstream ithute_push {
    server ithute-push:8080;
    keepalive 16;
}

upstream ithute_realtime {
    server ithute-realtime:8080;
    keepalive 16;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ithute.co.ls www.ithute.co.ls auth.ithute.co.ls push.ithute.co.ls realtime.ithute.co.ls;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.ithute.co.ls;

    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;
    include /etc/nginx/snippets/ithute-tls.conf;

    return 308 https://ithute.co.ls$request_uri;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name ithute.co.ls;

    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;
    include /etc/nginx/snippets/ithute-tls.conf;

    add_header X-Ithute-Service "web" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location / {
        proxy_pass http://ithute_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name auth.ithute.co.ls;

    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;
    include /etc/nginx/snippets/ithute-tls.conf;

    client_max_body_size 10m;
    add_header X-Ithute-Service "auth" always;

    location / {
        proxy_pass http://ithute_auth;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name push.ithute.co.ls;

    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;
    include /etc/nginx/snippets/ithute-tls.conf;

    client_max_body_size 10m;
    add_header X-Ithute-Service "push" always;

    location / {
        proxy_pass http://ithute_push;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name realtime.ithute.co.ls;

    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;
    include /etc/nginx/snippets/ithute-tls.conf;

    client_max_body_size 10m;
    add_header X-Ithute-Service "realtime" always;

    location / {
        proxy_pass http://ithute_realtime;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
    }
}

# Unknown hostnames must never fall through to another Ithute application.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name _;

    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;
    include /etc/nginx/snippets/ithute-tls.conf;

    return 404;
}
