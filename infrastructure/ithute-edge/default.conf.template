map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Docker embedded DNS. External platform/product targets are resolved at
# request time so one temporarily missing service can never prevent the shared
# public edge from starting for every domain.
resolver 127.0.0.11 ipv6=off valid=30s;

upstream ithute_web {
    server ithute-web:3000;
    keepalive 32;
}

# Redirect only hostnames explicitly owned by this shared edge. Unknown HTTP
# hosts are handled by the separate default server below and never fall through
# to Ithute or LoanHub.
server {
    listen 80;
    listen [::]:80;
    server_name
        ithute.co.ls
        www.ithute.co.ls
        auth.ithute.co.ls
        push.ithute.co.ls
        realtime.ithute.co.ls
        ${APP_DOMAIN}
        ${WWW_DOMAIN}
        ${API_DOMAIN}
        ${SANDBOX_APP_DOMAIN}
        ${SANDBOX_API_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 404;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.ithute.co.ls;

    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;
    include /etc/nginx/snippets/ithute-tls.conf;

    return 308 https://ithute.co.ls$request_uri;
}

# Ithute owns only its explicit apex hostname. It is deliberately not the TLS
# default server, so another domain can never render the Ithute application by
# accident.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ithute.co.ls;

    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;
    include /etc/nginx/snippets/ithute-tls.conf;

    add_header X-Ithute-Service "web" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location / {
        proxy_pass http://ithute_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name auth.ithute.co.ls;

    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
