map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

resolver 127.0.0.11 ipv6=off valid=30s;

upstream mailbox_gateway {
    server nginx:80;
    keepalive 32;
}

upstream loanhub_frontend {
    server loanhub-frontend:3000;
    keepalive 16;
}

upstream loanhub_backend {
    server loanhub-backend:8000;
    keepalive 16;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name
        ithute.co.ls
        www.ithute.co.ls
        panel.ithute.co.ls
        api.ithute.co.ls
        auth.ithute.co.ls
        push.ithute.co.ls
        realtime.ithute.co.ls
        groupware.ithute.co.ls
        pay.ithute.co.ls
        api.pay.ithute.co.ls
        portal.pay.ithute.co.ls
        mail.ithute.co.ls
        ${APP_DOMAIN}
        ${WWW_DOMAIN}
        ${API_DOMAIN}
        ${SANDBOX_APP_DOMAIN}
        ${SANDBOX_API_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.ithute.co.ls;

    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;
    include /etc/nginx/snippets/ithute-tls.conf;

    return 308 https://ithute.co.ls$request_uri;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name
        ithute.co.ls
        panel.ithute.co.ls
        api.ithute.co.ls
        auth.ithute.co.ls
        push.ithute.co.ls
        realtime.ithute.co.ls
        groupware.ithute.co.ls
        pay.ithute.co.ls
        api.pay.ithute.co.ls
        portal.pay.ithute.co.ls;

    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;
    include /etc/nginx/snippets/ithute-tls.conf;

    client_max_body_size 25m;

    location / {
        proxy_pass http://mailbox_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name mail.ithute.co.ls;

    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;
    include /etc/nginx/snippets/ithute-tls.conf;

    return 204;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${WWW_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;
    include /etc/nginx/snippets/ithute-tls.conf;

    return 308 https://${APP_DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;
    include /etc/nginx/snippets/ithute-tls.conf;

    location / {
        proxy_pass http://loanhub_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;
    include /etc/nginx/snippets/ithute-tls.conf;

    client_max_body_size 30m;

    location / {
        proxy_pass http://loanhub_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SANDBOX_APP_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;
    include /etc/nginx/snippets/ithute-tls.conf;

    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    location / {
        set $sandbox_frontend_upstream http://sandbox_frontend:3000;
        proxy_pass $sandbox_frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SANDBOX_API_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;
    include /etc/nginx/snippets/ithute-tls.conf;

    client_max_body_size 30m;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    location / {
        set $sandbox_backend_upstream http://sandbox_backend:8000;
        proxy_pass $sandbox_backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
