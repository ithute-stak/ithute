ITHUTE_API_URL=https://ithute.co.ls
ITHUTE_MAIL_AGENT_TOKEN=ith_mail_REPLACE_ME
ITHUTE_MAIL_HOSTNAME=mail-node-01.example.com
ITHUTE_MAIL_ACCOUNTS_FILE=/tmp/docker-mailserver/postfix-accounts.cf
ITHUTE_MAIL_QUOTAS_FILE=/tmp/docker-mailserver/dovecot-quotas.cf
ITHUTE_MAIL_STORAGE_PATH=/srv/ithute-mail
ITHUTE_MAIL_POLL_SECONDS=10
ITHUTE_MAIL_HEARTBEAT_SECONDS=60
ITHUTE_MAIL_BACKUP_ROOT=/var/lib/ithute-mail-node/backups
ITHUTE_MAIL_BACKUP_REMOTE_REQUIRED=true
ITHUTE_MAIL_BACKUP_REMOTE=remote:ithute-mail-backups/production
ITHUTE_MAIL_RCLONE_CONFIG=/etc/ithute-mail-node/rclone.conf
ITHUTE_MAIL_RCLONE=rclone
ITHUTE_MAIL_CONTAINER=ithute-mail
