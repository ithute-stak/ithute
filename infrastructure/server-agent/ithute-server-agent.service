[Unit]
Description=Ithute Physical Server Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/ithute/server-agent.env
ExecStart=/usr/bin/python3 /opt/ithute/server-agent/agent.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/
ReadWritePaths=/var/log/ithute /var/lib/ithute/server-agent
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
