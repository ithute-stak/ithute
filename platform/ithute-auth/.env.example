AUTH_DATABASE_URL=postgresql+psycopg://ithute_auth:change-me@db:5432/ithute_auth
AUTH_ISSUER=https://auth.ithute.co.ls
AUTH_ACCESS_TOKEN_MINUTES=10
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_SERVICE_TOKEN_MINUTES=5
# Dedicated Push user tokens are intentionally much shorter-lived than product access tokens.
AUTH_PUSH_USER_TOKEN_MINUTES=3
AUTH_AUTHORIZATION_CODE_MINUTES=5
AUTH_BROWSER_SESSION_HOURS=8
AUTH_BROWSER_COOKIE_NAME=ithute_sso
AUTH_BROWSER_COOKIE_SECURE=true
AUTH_PASSWORD_RESET_MINUTES=30
AUTH_VERIFICATION_CODE_MINUTES=10
# Abuse controls for password recovery and verification message delivery.
AUTH_RECOVERY_RATE_WINDOW_SECONDS=3600
AUTH_RECOVERY_MAX_REQUESTS_PER_IP=20
AUTH_RECOVERY_MAX_REQUESTS_PER_USER=5
AUTH_VERIFICATION_RATE_WINDOW_SECONDS=3600
AUTH_VERIFICATION_MAX_REQUESTS_PER_USER=6
# Six-digit verification code brute-force protection.
AUTH_VERIFICATION_CONFIRM_RATE_WINDOW_SECONDS=900
AUTH_VERIFICATION_CONFIRM_MAX_FAILURES_PER_USER=10
AUTH_MAX_LOGIN_FAILURES=5
AUTH_LOGIN_LOCK_MINUTES=15
AUTH_LOGIN_RATE_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_MAX_FAILURES_PER_IP=50
# Only peers inside these CIDRs may supply X-Forwarded-For. Add the production edge/proxy network explicitly.
AUTH_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
AUTH_TOTP_ISSUER_NAME=!thute
# Required for MFA. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_TOTP_ENCRYPTION_KEY=
AUTH_ACCOUNT_BASE_URL=https://auth.ithute.co.ls

# Auth -> Push lifecycle outbox delivery. This is an internal service URL, not a public browser URL.
AUTH_PUSH_EVENTS_URL=http://ithute-push:8080/v1/internal/auth-events
AUTH_PUSH_EVENT_WORKER_POLL_SECONDS=2
AUTH_PUSH_EVENT_REQUEST_TIMEOUT_SECONDS=5
# Crash-safe claim lease; must exceed a normal single request timeout.
AUTH_PUSH_EVENT_LEASE_SECONDS=30

# WebAuthn / passkeys. Production origin must be HTTPS and match the browser origin.
AUTH_WEBAUTHN_RP_ID=auth.ithute.co.ls
AUTH_WEBAUTHN_RP_NAME=!thute
AUTH_WEBAUTHN_ORIGIN=https://auth.ithute.co.ls
AUTH_WEBAUTHN_CHALLENGE_MINUTES=5

AUTH_JWT_PRIVATE_KEY_FILE=/run/secrets/jwt-private.pem
AUTH_JWT_PUBLIC_KEY_FILE=/run/secrets/jwt-public.pem
AUTH_JWT_KEY_ID=ithute-auth-2026-01
# During signing-key rotation, keep retired public JWKs here until all tokens signed by them have expired.
AUTH_PREVIOUS_JWKS_JSON=[]
AUTH_FIRST_PARTY_CLIENTS=loanhub:LoanHub,rsl-pos:RSL POS,mailbox-dns:Mailbox DNS,ithute-account:Ithute Account,ithute-tutor:Ithute Tutor,ithute-pay:Ithute Pay,nbros:NBros,ithute-realtime:!thute Realtime
# Exact per-client callback allowlist. Production entries should use HTTPS; HTTP is accepted only for localhost/127.0.0.1 development.
# Keep every active product callback when overriding this JSON at runtime.
AUTH_REDIRECT_URIS_JSON={"ithute-tutor":["https://tutor.ithute.co.ls/api/auth/oidc/callback"],"nbros":["https://nbro.ithute.co.ls/api/auth/oidc/callback"]}
# Runtime-only JSON mapping. The Tutor value must exactly match ITHUTE_TUTOR_PUSH_SERVICE_CLIENT_SECRET.
# Add Pay/Realtime or other service clients at runtime without removing Tutor.
AUTH_SERVICE_CLIENT_SECRETS_JSON={"ithute-tutor":"replace-with-a-long-random-tutor-service-secret"}
AUTH_CORS_ORIGINS=https://panel.ithute.co.ls,https://tutor.ithute.co.ls,https://nbro.ithute.co.ls

# Email delivery for password recovery and email verification.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=
AUTH_SMTP_STARTTLS=true

# Provider-neutral SMS adapter. The endpoint receives JSON: {"phone":"...","message":"..."}.
AUTH_SMS_WEBHOOK_URL=
AUTH_SMS_WEBHOOK_TOKEN=

POSTGRES_DB=ithute_auth
POSTGRES_USER=ithute_auth
POSTGRES_PASSWORD=change-me
