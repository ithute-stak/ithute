PUSH_DATABASE_URL=postgresql+psycopg://ithute_push:change-me@db:5432/ithute_push
# Push verifies Auth locally through RS256/JWKS. It never shares the Auth database.
PUSH_AUTH_ISSUER=https://auth.ithute.co.ls
PUSH_AUTH_JWKS_URL=https://auth.ithute.co.ls/.well-known/jwks.json
# User calls require Auth-minted aud=ithute-push, token_use=push_access, scope=push.device tokens.
PUSH_ALLOWED_USER_CLIENTS=loanhub,rsl-pos,mailbox-dns,ithute-account,ithute-tutor,ithute-pay
# Backend send calls require aud=ithute-push, token_use=service, scope=push.send tokens.
PUSH_ALLOWED_SERVICE_CLIENTS=loanhub,rsl-pos,mailbox-dns,ithute-account,ithute-tutor,ithute-pay,ithute-realtime
# Only central platform services listed here may send on behalf of another product namespace.
PUSH_DELEGATED_SERVICE_CLIENTS=ithute-realtime
# Privileged platform-console tokens are separate from ordinary user/service tokens.
PUSH_ALLOWED_ADMIN_CLIENTS=mailbox-dns
# Token boundary hardening. Keep these ceilings >= Auth's issued lifetimes and small enough to limit replay exposure.
PUSH_AUTH_CLOCK_SKEW_SECONDS=30
PUSH_AUTH_MAX_PUSH_ACCESS_SECONDS=600
PUSH_AUTH_MAX_SERVICE_TOKEN_SECONDS=600
PUSH_AUTH_MAX_ADMIN_TOKEN_SECONDS=180
PUSH_ENDPOINT_ENCRYPTION_KEY=
PUSH_WORKER_POLL_SECONDS=2
PUSH_MAX_ATTEMPTS=4
# Android/FCM is the v1 baseline. Add apns/webpush only when their credentials are installed.
PUSH_REQUIRED_PROVIDERS=fcm

PUSH_FCM_PROJECT_ID=
PUSH_FCM_CREDENTIALS_FILE=/run/secrets/fcm-service-account.json
# Android apps must create a matching HIGH-importance notification channel with sound.
PUSH_FCM_ANDROID_CHANNEL_ID=ithute_default

PUSH_APNS_TEAM_ID=
PUSH_APNS_KEY_ID=
PUSH_APNS_BUNDLE_ID=
PUSH_APNS_PRIVATE_KEY_FILE=/run/secrets/apns-private-key.p8
PUSH_APNS_USE_SANDBOX=false

PUSH_VAPID_SUBJECT=mailto:admin@ithute.co.ls
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY_FILE=/run/secrets/vapid-private-key.pem

POSTGRES_DB=ithute_push
POSTGRES_USER=ithute_push
POSTGRES_PASSWORD=change-me
