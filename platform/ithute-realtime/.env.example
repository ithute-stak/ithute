REALTIME_DATABASE_URL=postgresql+psycopg://ithute_realtime:replace-me@localhost:5432/ithute_realtime
REALTIME_REDIS_URL=redis://localhost:6379/0
REALTIME_PUBLIC_URL=https://realtime.ithute.co.ls

REALTIME_AUTH_ISSUER=https://auth.ithute.co.ls
REALTIME_AUTH_JWKS_URL=https://auth.ithute.co.ls/.well-known/jwks.json
REALTIME_ALLOWED_USER_CLIENTS=loanhub,rsl-pos,mailbox-dns,ithute-account,ithute-tutor,ithute-pay,nbros
REALTIME_ALLOWED_SERVICE_CLIENTS=loanhub,rsl-pos,mailbox-dns,ithute-account,ithute-tutor,ithute-pay,nbros
# Emergency operational kill switch. Comma-separated product client IDs.
REALTIME_DISABLED_CLIENTS=

REALTIME_AUTH_SERVICE_TOKEN_URL=http://localhost:8080/v1/auth/service-token
REALTIME_PLATFORM_CLIENT_ID=ithute-realtime
REALTIME_PLATFORM_CLIENT_SECRET=replace-with-runtime-service-secret
REALTIME_PUSH_URL=http://localhost:8082
REALTIME_PUSH_ENABLED=true

REALTIME_WEBSOCKET_AUTH_TIMEOUT_SECONDS=10
REALTIME_WEBSOCKET_PRESENCE_TTL_SECONDS=90
REALTIME_WEBSOCKET_IDLE_TIMEOUT_SECONDS=120
REALTIME_WEBSOCKET_SEND_TIMEOUT_SECONDS=5
REALTIME_MAX_CONNECTIONS_PER_USER=8
REALTIME_MAX_CONNECTIONS_PER_DEVICE=3

REALTIME_MAX_MESSAGE_CHARS=4000
REALTIME_MAX_GROUP_MEMBERS=500
REALTIME_MAX_HISTORY_PAGE_SIZE=200
REALTIME_MAX_EVENT_RECIPIENTS=5000
REALTIME_MAX_REPLAY_PAGE_SIZE=500

REALTIME_USER_SEND_RATE_LIMIT=120
REALTIME_USER_SEND_RATE_WINDOW_SECONDS=60
REALTIME_ACTIVITY_RATE_LIMIT=180
REALTIME_ACTIVITY_RATE_WINDOW_SECONDS=60
REALTIME_SERVICE_PUBLISH_RATE_LIMIT=1000
REALTIME_SERVICE_PUBLISH_RATE_WINDOW_SECONDS=60

REALTIME_EVENT_MAX_ATTEMPTS=5
REALTIME_EVENT_RETRY_SECONDS=10
REALTIME_EVENT_WORKER_POLL_SECONDS=1
REALTIME_EVENT_RETENTION_DAYS=30
REALTIME_AUDIT_RETENTION_DAYS=180
