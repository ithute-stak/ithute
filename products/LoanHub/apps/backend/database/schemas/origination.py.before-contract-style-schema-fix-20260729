class BankAccountInput(BaseModel):
    """Secure bank account and tokenized card data.

    CVV/CVC, PIN and a raw full payment-card number are deliberately rejected.
    """

    model_config = ConfigDict(extra="forbid")

    account_holder: str = Field(min_length=2, max_length=200)
    bank_name: str = Field(min_length=2, max_length=160)
    branch_name: str | None = Field(default=None, max_length=160)
    branch_code: str | None = Field(default=None, max_length=40)
    account_type: str = Field(default="savings", max_length=40)
    currency: str = Field(default="LSL", min_length=3, max_length=3)
    account_number: str | None = Field(default=None, min_length=4, max_length=40)
    salary_account: bool = False
    verification_status: Literal["unverified", "pending", "verified", "failed"] = "unverified"
    verification_reference: str | None = Field(default=None, max_length=180)
    tokenized_card_provider: str | None = Field(default=None, max_length=80)
    tokenized_card_reference: str | None = Field(default=None, max_length=500)
    masked_card_number: str | None = Field(default=None, max_length=30)
    card_brand: str | None = Field(default=None, max_length=30)
    card_expiry_month: int | None = Field(default=None, ge=1, le=12)
    card_expiry_year: int | None = Field(default=None, ge=2024, le=2200)

    @field_validator("account_number")
    @classmethod
    def normalize_account_number(cls, value: str | None) -> str | None:
        if value is None or not value.strip():
            return None
        cleaned = "".join(ch for ch in value if ch.isalnum())
        if len(cleaned) < 4:
            raise ValueError("A valid bank account number is required")
        return cleaned

    @field_validator("masked_card_number")
    @classmethod
    def reject_raw_pan(cls, value: str | None) -> str | None:
        if not value:
            return value
        digits = "".join(ch for ch in value if ch.isdigit())
        if len(digits) > 6:
            raise ValueError("Do not send a full card number. Store only a provider token and masked card value")
        return value


