def _asset_path(configured_value: str) -> Path | None:
    configured = Path(configured_value).expanduser()
    if not configured.is_absolute():
        configured = Path(__file__).resolve().parents[1] / configured
    return configured if configured.exists() else None


def _logo_path() -> Path | None:
    contract_logo = _asset_path("assets/loanhub-contract-logo.png")
    return contract_logo or _asset_path(settings.LOANHUB_LOGO_PATH)


def _as_decimal(value: Any) -> Decimal:
    try:
        return Decimal(str(value or 0))
    except (InvalidOperation, ValueError, TypeError):
        return Decimal("0")


def _money(value: Any) -> str:
    return f"LSL {_as_decimal(value):,.2f}"


def _percentage(value: Any) -> str:
    number = _as_decimal(value)
    return f"{number:,.3f}".rstrip("0").rstrip(".") + "%"


def _date_text(value: Any) -> str:
    if not value:
        return "Not recorded"
    if isinstance(value, datetime):
        value = value.date()
    if isinstance(value, date):
        return value.strftime("%d %B %Y")
    try:
        return date.fromisoformat(str(value)[:10]).strftime("%d %B %Y")
    except ValueError:
        return str(value)


def _timestamp_text(value: Any) -> str:
    if not value:
        return "Pending"
    if isinstance(value, str):
        try:
            value = datetime.fromisoformat(value.replace("Z", "+00:00"))
        except ValueError:
            return value
    if isinstance(value, datetime):
        return value.astimezone(timezone.utc).strftime("%d %B %Y at %H:%M UTC")
    return str(value)


def _enum_text(value: Any) -> str:
    raw = getattr(value, "value", value)
    return str(raw or "Not recorded").replace("_", " ").title()


def _safe(value: Any, fallback: str = "Not recorded") -> str:
    text = str(value).strip() if value is not None else ""
    return escape(text or fallback)


def _person_for_user(db: Session, user_id: UUID | None) -> Person | None:
    if not user_id:
        return None
    return db.query(Person).filter(Person.user_id == user_id).first()


def _borrower_snapshot(db: Session, loan: ClientCompanyLoan) -> dict[str, Any]:
    borrower = loan.borrower
    user = db.get(User, borrower.user_id) if borrower else None
    person = _person_for_user(db, user.id if user else None)
    identity_number = None
    identity_type = "Identity number"
    if person and person.national_id:
        identity_number = person.national_id
        identity_type = "National ID"
    elif person and person.passport_number:
        identity_number = person.passport_number
        identity_type = "Passport"
    address_parts = []
    if person:
        address_parts = [person.physical_address, person.town_or_village, person.district]
    return {
        "id": str(loan.borrower_id),
        "name": person.full_name if person else "Borrower",
        "identity_type": identity_type,
        "identity_number": identity_number,
        "date_of_birth": person.date_of_birth.isoformat() if person and person.date_of_birth else None,
        "marital_status": _enum_text(person.marital_status) if person else None,
        "nationality": person.nationality if person else None,
        "physical_address": ", ".join(str(item).strip() for item in address_parts if item and str(item).strip()) or None,
        "phone": user.phone if user else None,
        "email": user.email if user else None,
        "employment_status": _enum_text(borrower.employment_status) if borrower else None,
        "employer_name": borrower.employer_name if borrower else None,
        "job_title": borrower.job_title if borrower else None,
        "monthly_income": str(borrower.monthly_income or 0) if borrower else "0",
        "salary_date": borrower.salary_date if borrower else None,
    }


def _borrower_bank_snapshot(db: Session, loan: ClientCompanyLoan) -> dict[str, Any]:
    """Freeze the borrower banking mandate without storing a plaintext account number.

    The encrypted account value is copied into the immutable contract snapshot and is
    decrypted only while the confidential PDF is being rendered. This keeps regenerated
    signed versions consistent even if the borrower later edits their banking profile.
    """
    account = (
        db.query(BorrowerBankAccount)
        .filter(
            BorrowerBankAccount.company_id == loan.company_id,
            BorrowerBankAccount.borrower_id == loan.borrower_id,
        )
        .first()
    )
    if not account:
        return {
            "account_holder": None,
            "bank_name": None,
            "branch_name": None,
            "branch_code": None,
            "account_type": None,
            "currency": "LSL",
            "account_number_encrypted": None,
            "account_number_last4": None,
            "verification_status": "not_recorded",
        }
    return {
        "account_holder": account.account_holder,
        "bank_name": account.bank_name,
        "branch_name": account.branch_name,
        "branch_code": account.branch_code,
        "account_type": account.account_type,
        "currency": account.currency or "LSL",
        "account_number_encrypted": account.account_number_encrypted,
        "account_number_last4": account.account_number_last4,
        "verification_status": account.verification_status,
    }


def _bank_account_number(bank: dict[str, Any] | None) -> str:
    bank = bank or {}
    encrypted = bank.get("account_number_encrypted")
    if encrypted:
        try:
            return decrypt_credential(str(encrypted))
        except RuntimeError:
            pass
    last4 = str(bank.get("account_number_last4") or "").strip()
    return f"****{last4}" if last4 else "Not recorded"


def build_terms(db: Session, loan: ClientCompanyLoan) -> dict[str, Any]:
    company = db.get(LoanCompany, loan.company_id)
    branch = db.get(CompanyBranch, loan.branch_id) if loan.branch_id else None
    application = db.get(DirectLoanApplication, loan.direct_application_id) if loan.direct_application_id else None
    product = db.get(LoanProduct, application.product_id) if application and application.product_id else None
    credit_officer = _person_for_user(db, application.captured_by_user_id if application else None)
    bank_account = _borrower_bank_snapshot(db, loan)

    schedule: list[dict[str, Any]] = []
    for item in sorted(loan.installments, key=lambda row: row.installment_number):
        schedule.append({
            "number": item.installment_number,
            "due_date": item.due_date.isoformat(),
            "principal": str(item.principal_due or 0),
            "interest": str(item.interest_due or 0),
            "fee": str(item.fee_due or 0),
            "amount": str(item.total_due or 0),
        })

    schedule_total = sum((_as_decimal(item["amount"]) for item in schedule), Decimal("0"))
    total_repayable = _as_decimal(loan.total_repayable)
    if abs(schedule_total - total_repayable) > Decimal("0.02"):
        raise HTTPException(
            status_code=409,
            detail=(
                "The repayment schedule total does not equal the approved total repayable. "
                "Recalculate the loan schedule before generating the agreement."
            ),
        )

    total_interest = sum((_as_decimal(item["interest"]) for item in schedule), Decimal("0"))
    total_schedule_fees = sum((_as_decimal(item["fee"]) for item in schedule), Decimal("0"))
    total_cost = total_repayable - _as_decimal(loan.principal_amount)
    total_fees = max(total_cost - total_interest, Decimal("0"))

    return {
        "template_version": "3.0-filizwa-merged",
        "legal_basis": (
            "Applicable Lesotho lending law, including the Money Lenders Order, 1989 as amended, "
            "and the Financial Consumer Protection Act, 2022."
        ),
        "company": {
            "id": str(company.id) if company else None,
            "name": company.name if company else "Loan company",
            "registration_number": company.registration_number if company else None,
            "license_number": company.license_number if company else None,
            "address": company.address if company else None,
            "district": company.district if company else None,
            "phone": company.phone if company else None,
            "email": company.email if company else None,
            "website": company.website if company else None,
        },
        "branch": {
            "id": str(branch.id) if branch else None,
            "name": branch.name if branch else "Head office",
            "address": branch.address if branch else None,
            "town": branch.town if branch else None,
            "district": branch.district if branch else None,
            "phone": branch.phone if branch else None,
            "email": branch.email if branch else None,
        },
        "borrower": _borrower_snapshot(db, loan),
        "bank_account": bank_account,
        "application_reference": application.application_reference if application else None,
        "application_purpose": application.purpose if application else None,
        "loan_product_name": product.name if product else "Personal loan",
        "credit_officer_name": credit_officer.full_name if credit_officer else None,
        "loan_reference": loan.loan_reference,
        "agreement_date": (loan.approved_at or datetime.now(timezone.utc)).date().isoformat(),
        "approved_at": loan.approved_at.isoformat() if loan.approved_at else None,
        "is_top_up": bool(loan.is_top_up),
        "parent_loan_id": str(loan.parent_loan_id) if loan.parent_loan_id else None,
        "top_up_settlement_amount": str(loan.top_up_settlement_amount or 0),
        "top_up_cash_amount": str(loan.top_up_cash_amount or 0),
        "principal_amount": str(loan.principal_amount),
        "interest_rate": str(loan.interest_rate),
        "interest_rate_basis": "Approved loan rate",
        "total_interest": str(total_interest),
        "processing_fee": str(loan.processing_fee or 0),
        "total_fees": str(total_fees),
        "schedule_fees": str(total_schedule_fees),
        "total_cost_of_credit": str(total_cost),
        "tax_amount": "0.00",
        "total_repayable": str(loan.total_repayable),
        "installment_amount": str(loan.installment_amount),
        "repayment_period": loan.repayment_period,
        "repayment_type": _enum_text(loan.repayment_type),
        "first_payment_due": loan.first_payment_due.isoformat() if loan.first_payment_due else None,
        "preferred_payment_day": loan.preferred_payment_day,
        "maturity_date": loan.maturity_date.isoformat() if loan.maturity_date else None,
        "calculation_method": loan.calculation_method,
        "calculation_breakdown": loan.calculation_breakdown or {},
        "schedule": schedule,
        "schedule_total": str(schedule_total),
        "payment_method": "Cash, mobile money, bank transfer, salary deduction, debit order or another approved method",
        "disbursement_method": "To be recorded at disbursement",
        "security_type": "Unsecured unless a separately signed security annexure states otherwise",
        "insurance_status": "Not included unless a separately signed insurance addendum states otherwise",
        "cooling_off_period": "Five working days after both parties enter into the agreement",
