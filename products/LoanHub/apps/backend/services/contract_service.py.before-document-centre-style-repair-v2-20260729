def _p(value: Any, style: ParagraphStyle, fallback: str = "Not recorded") -> Paragraph:
    return Paragraph(_safe(value, fallback), style)


def _key_value_table(rows: list[tuple[str, Any]], styles: dict[str, ParagraphStyle], *, widths: tuple[float, float] = (52 * mm, 123 * mm)) -> Table:
    """Render labelled values as soft cards rather than a spreadsheet-like grid."""
    card_width = 85.5 * mm
    cards: list[Table] = []
    for label, value in rows:
        card = Table(
            [[_p(label.upper(), styles["table_label"])], [_p(value, styles["table_value"])]],
            colWidths=[card_width],
        )
        card.setStyle(TableStyle([
            ("BACKGROUND", (0, 0), (-1, -1), LIGHT),
            ("BOX", (0, 0), (-1, -1), 0.55, BORDER),
            ("LINEBEFORE", (0, 0), (0, -1), 2.6, BLUE),
            ("LEFTPADDING", (0, 0), (-1, -1), 8),
            ("RIGHTPADDING", (0, 0), (-1, -1), 8),
            ("TOPPADDING", (0, 0), (-1, 0), 6),
            ("BOTTOMPADDING", (0, 0), (-1, -1), 5),
            ("VALIGN", (0, 0), (-1, -1), "TOP"),
        ]))
        cards.append(card)
    grid: list[list[Any]] = []
    for index in range(0, len(cards), 2):
        row = cards[index:index + 2]
        if len(row) == 1:
            row.append("")
        grid.append(row)
    outer = Table(grid, colWidths=[87.5 * mm, 87.5 * mm])
    outer.setStyle(TableStyle([
        ("VALIGN", (0, 0), (-1, -1), "TOP"),
        ("LEFTPADDING", (0, 0), (0, -1), 0),
        ("RIGHTPADDING", (0, 0), (0, -1), 2 * mm),
        ("LEFTPADDING", (1, 0), (1, -1), 2 * mm),
        ("RIGHTPADDING", (1, 0), (1, -1), 0),
        ("TOPPADDING", (0, 0), (-1, -1), 0),
        ("BOTTOMPADDING", (0, 0), (-1, -1), 3 * mm),
    ]))
    return outer


def _two_party_table(terms: dict[str, Any], styles: dict[str, ParagraphStyle]) -> Table:
    company = terms["company"]
    branch = terms["branch"]
    borrower = terms["borrower"]
    lender_address = ", ".join(
        str(value).strip()
        for value in [company.get("address"), company.get("district")]
        if value and str(value).strip()
    )
    left = [
        _p("LENDER", styles["table_label"]),
        _p(company.get("name"), styles["table_value"]),
        _p(f"Registration: {company.get('registration_number') or 'Not recorded'}", styles["small"]),
        _p(f"Licence: {company.get('license_number') or 'Not recorded'}", styles["small"]),
        _p(f"Address: {lender_address or 'Not recorded'}", styles["small"]),
        _p(f"Contact: {company.get('phone') or 'Not recorded'} | {company.get('email') or 'Not recorded'}", styles["small"]),
