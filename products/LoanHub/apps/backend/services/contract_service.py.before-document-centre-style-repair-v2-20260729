                ("Company signature", _timestamp_text(contract.company_signed_at)),
                ("Locked", _timestamp_text(contract.locked_at)),
                ("System", f"{settings.PRODUCT_NAME} by {settings.DEVELOPER_NAME}"),
            ], styles),
        ]),
        Spacer(1, 4 * mm),
        Paragraph(
            "LEGAL REVIEW NOTICE: This template follows the structure and commercial content of the supplied Filizwa agreement but has been "
            "localised for Lesotho and merged with LoanHub disclosures, branding and audit controls. Each lender remains responsible for legal review, "
            "licence details, pricing, notices, mandates, statement charges, enforcement wording and regulatory compliance before production use.",
            styles["small"],
        ),
    ])

    document.build(
        story,
        canvasmaker=lambda *args, **kwargs: _ContractCanvas(*args, contract=contract, db=db, **kwargs),
    )
    return buffer.getvalue()


def _store_contract_pdf(
    db: Session,
    *,
    contract: LoanContract,
    requested_by_user_id: UUID,
    increment_version: bool,
) -> ManagedFile:
    if increment_version:
        contract.version = int(contract.version or 1) + 1
    content = _contract_pdf(db, contract)
    managed = store_bytes(
        db,
        content=content,
        original_name=f"{contract.contract_number}-v{contract.version}.pdf",
        mime_type="application/pdf",
        owner_user_id=requested_by_user_id,
        company_id=contract.company_id,
        branch_id=contract.loan.branch_id if contract.loan else None,
        category="loan_contract",
        visibility="company",
        description=f"Credit agreement {contract.contract_number}, PDF version {contract.version}",
        linked_entity_type="loan_contract",
        linked_entity_id=str(contract.id),
        is_confidential=True,
    )
    contract.pdf_file_id = managed.id
    return managed


def contract_pdf_bytes(
    db: Session,
    *,
    contract: LoanContract,
    requested_by_user_id: UUID,
) -> bytes:
    """Return the current contract PDF, repairing missing local storage on demand.

    Managed-file rows can survive a database restore while the corresponding
    local storage directory does not. A print action must therefore treat a
    missing physical PDF as a recoverable generated-artifact problem, not as a
    permanently gone document. Recovery preserves the contract version and is
    allowed for locked/signed contracts because the legal terms are unchanged.
    """
    if contract.pdf_file_id:
        managed = db.get(ManagedFile, contract.pdf_file_id)
        if managed and not managed.is_deleted:
            try:
                return read_file_bytes(managed)
            except HTTPException as error:
                if error.status_code != 410:
                    raise

    managed = _store_contract_pdf(
        db,
        contract=contract,
        requested_by_user_id=requested_by_user_id,
        increment_version=False,
    )
    db.commit()
    db.refresh(contract)
    return read_file_bytes(managed)


def generate_contract(
    db: Session,
    *,
    loan: ClientCompanyLoan,
    requested_by_user_id: UUID,
    witness_name: str | None = None,
) -> LoanContract:
    existing = db.query(LoanContract).filter(LoanContract.loan_id == loan.id).first()
    if existing:
        return existing
    if not loan.installments:
        raise HTTPException(status_code=409, detail="Repayment schedule must exist before contract generation")

    terms = build_terms(db, loan)
    canonical = json.dumps(terms, sort_keys=True, separators=(",", ":"), default=str)
    digest = hashlib.sha256(canonical.encode("utf-8")).hexdigest()
    contract = LoanContract(
        company_id=loan.company_id,
        borrower_id=loan.borrower_id,
        application_id=loan.direct_application_id,
        loan_id=loan.id,
        contract_number=f"LHC-{datetime.now(timezone.utc):%Y%m%d}-{str(loan.id).replace('-', '')[:10].upper()}",
        version=1,
        status="awaiting_signatures",
        terms_snapshot=terms,
        contract_hash=digest,
        witness_name=witness_name.strip() if witness_name and witness_name.strip() else None,
    )
    db.add(contract)
    db.flush()
    _store_contract_pdf(
        db,
        contract=contract,
        requested_by_user_id=requested_by_user_id,
        increment_version=False,
    )
    db.commit()
    db.refresh(contract)
    return contract


def regenerate_contract_pdf(
    db: Session,
    *,
    contract: LoanContract,
    requested_by_user_id: UUID,
    increment_version: bool = True,
) -> LoanContract:
    if contract.locked_at and contract.status == "signed":
        raise HTTPException(status_code=409, detail="A fully signed contract is locked and cannot be regenerated")
    _store_contract_pdf(
        db,
        contract=contract,
        requested_by_user_id=requested_by_user_id,
        increment_version=increment_version,
    )
    db.commit()
    db.refresh(contract)
    return contract


def refresh_contract_pdf_after_signature(
    db: Session,
    *,
    contract: LoanContract,
    requested_by_user_id: UUID,
) -> None:
    """Refresh the PDF in the same transaction after a signature is recorded."""
    _store_contract_pdf(
        db,
        contract=contract,
        requested_by_user_id=requested_by_user_id,
        increment_version=True,
    )


def update_contract_status(contract: LoanContract) -> None:
    if contract.borrower_signed_at and contract.company_signed_at:
        contract.status = "signed"
        contract.locked_at = datetime.now(timezone.utc)
    elif contract.borrower_signed_at:
        contract.status = "borrower_signed"
    elif contract.company_signed_at:
        contract.status = "company_signed"
    else:
        contract.status = "awaiting_signatures"
