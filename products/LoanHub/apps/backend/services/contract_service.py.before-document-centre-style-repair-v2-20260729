class _ContractCanvas(canvas.Canvas):
    """Replays pages at save time so each page receives a branded header and Page X of Y footer."""

    def __init__(
        self,
        *args: Any,
        contract: LoanContract,
        db: Session | None = None,
        **kwargs: Any,
    ) -> None:
        super().__init__(*args, **kwargs)
        self._saved_page_states: list[dict[str, Any]] = []
        self.contract = contract
        self.db = db

    def showPage(self) -> None:  # noqa: N802 - ReportLab API
        self._saved_page_states.append(dict(self.__dict__))
        self._startPage()

    def save(self) -> None:
        page_count = len(self._saved_page_states)
        for state in self._saved_page_states:
            self.__dict__.update(state)
            self._draw_branding(page_count)
            super().showPage()
        super().save()

    def _draw_branding(self, page_count: int) -> None:
        """Draw the shared LoanHub/company Filizwa-style header on every page.

        The system logo is always loaded from LoanHub backend assets. The logo
        on the right is the current loan company's latest stored ManagedFile
        logo. Company identity details are read from the current LoanCompany
        record when the PDF is generated, with the immutable contract snapshot
        used only as a fallback if the company record cannot be loaded.
        """
        terms = self.contract.terms_snapshot or {}
        company_snapshot = terms.get("company", {})

        company_model = getattr(self.contract, "company", None)
        state = getattr(self.contract, "_sa_instance_state", None)
        session = self.db or getattr(state, "session", None)

        company_id = None
        raw_company_id = company_snapshot.get("id")
        if raw_company_id:
            try:
                company_id = UUID(str(raw_company_id))
            except (TypeError, ValueError):
                company_id = None

        if company_model is None and session is not None and company_id is not None:
            try:
                company_model = session.get(LoanCompany, company_id)
            except Exception:
                company_model = None

        if company_model is None:
            company_model = SimpleNamespace(
                id=company_id,
                name=company_snapshot.get("name") or "Loan company",
                registration_number=company_snapshot.get("registration_number"),
                license_number=company_snapshot.get("license_number"),
                phone=company_snapshot.get("phone"),
                email=company_snapshot.get("email"),
                website=company_snapshot.get("website"),
                address=company_snapshot.get("address"),
                district=company_snapshot.get("district"),
            )

        branding = get_company_document_branding(session, company_model)

        width, height = A4
        self.saveState()

        def draw_logo(
            payload: bytes | None,
            *,
            x: float,
            y: float,
            max_width: float,
            max_height: float,
            align: str,
        ) -> None:
            if not payload:
                return
            try:
                reader = ImageReader(BytesIO(payload))
                image_width, image_height = reader.getSize()
                scale = min(max_width / float(image_width), max_height / float(image_height))
                draw_width = image_width * scale
                draw_height = image_height * scale
                draw_x = x
                if align == "right":
                    draw_x = x - draw_width
                elif align == "center":
                    draw_x = x - (draw_width / 2)
                self.drawImage(
                    reader,
                    draw_x,
                    y - draw_height,
                    width=draw_width,
                    height=draw_height,
                    preserveAspectRatio=True,
                    mask="auto",
                )
            except Exception:
                # A damaged/missing optional image must never prevent a legal
                # document from rendering. The text identity remains visible.
                return

        logo_top = height - 7.5 * mm
        draw_logo(
            branding.system_logo,
            x=18 * mm,
            y=logo_top,
            max_width=43 * mm,
            max_height=15 * mm,
            align="left",
        )
        draw_logo(
            branding.company_logo,
            x=width - 18 * mm,
            y=logo_top,
            max_width=34 * mm,
            max_height=15 * mm,
            align="right",
        )

        centre_x = width / 2
        y = height - 9.5 * mm
        self.setFillColor(NAVY)
        self.setFont("Helvetica-Bold", 10.0)
        self.drawCentredString(centre_x, y, branding.company_name[:72])

        if branding.identity_line:
            y -= 4.0 * mm
            self.setFillColor(TEXT)
            self.setFont("Helvetica-Bold", 7.2)
            self.drawCentredString(centre_x, y, branding.identity_line[:92])

        if branding.contact_line:
            y -= 3.7 * mm
            self.setFillColor(MUTED)
            self.setFont("Helvetica", 6.8)
            self.drawCentredString(centre_x, y, branding.contact_line[:100])

        if branding.address_line:
            y -= 3.5 * mm
            self.setFillColor(MUTED)
            self.setFont("Helvetica", 6.7)
            self.drawCentredString(centre_x, y, branding.address_line[:100])

        self.setStrokeColor(BLUE)
        self.setLineWidth(0.8)
        self.line(18 * mm, height - 30.5 * mm, width - 18 * mm, height - 30.5 * mm)

        # Preserve LoanHub verification/audit information in the footer.
        self.setStrokeColor(BORDER)
        self.setLineWidth(0.45)
        self.line(18 * mm, 14 * mm, width - 18 * mm, 14 * mm)
        self.setFillColor(MUTED)
        self.setFont("Helvetica", 6.7)
        confidentiality = "CONFIDENTIAL | " if self.contract.status == "signed" else "DRAFT | "
        self.drawString(18 * mm, 9.5 * mm, f"{confidentiality}{self.contract.contract_number}"[:92])
        self.drawCentredString(
            width / 2,
            9.5 * mm,
            f"Verification {self.contract.contract_hash[:16]} | {self._pageNumber} of {page_count}"[:100],
        )
        self.drawRightString(width - 18 * mm, 9.5 * mm, f"Page {self._pageNumber}")

        self.restoreState()

        if self.contract.status != "signed":
            self.saveState()
            self.setFillColor(colors.Color(0.7, 0.75, 0.8, alpha=0.11))
            self.setFont("Helvetica-Bold", 40)
            self.translate(width / 2, height / 2)
            self.rotate(34)
            self.drawCentredString(0, 0, "AWAITING SIGNATURES")
            self.restoreState()


