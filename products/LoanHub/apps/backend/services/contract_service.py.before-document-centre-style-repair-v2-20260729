        ["2.5 Total charge of credit [2.1 to 2.4]", _money(terms.get("total_cost_of_credit"))],
        ["3. Approved interest rate", _percentage(terms.get("interest_rate"))],
        ["4. Total amount added to the loan amount", _money(terms.get("total_cost_of_credit"))],
