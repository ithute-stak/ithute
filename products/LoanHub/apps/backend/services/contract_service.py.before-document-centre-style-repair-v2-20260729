def _cost_elements_table(terms: dict[str, Any], styles: dict[str, ParagraphStyle]) -> Table:
    processing_fee = _as_decimal(terms.get("processing_fee"))
    total_fees = _as_decimal(terms.get("total_fees"))
    other_fees = max(total_fees - processing_fee, Decimal("0"))
    rows = [
        ["2.1 Amount of interest charged", _money(terms.get("total_interest"))],
        ["2.2 Initiation / processing fee", _money(processing_fee)],
        ["2.3 Other service and schedule fees", _money(other_fees)],
