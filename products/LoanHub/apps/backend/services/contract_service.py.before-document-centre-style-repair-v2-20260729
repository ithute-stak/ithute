        ], styles),
        Spacer(1, 4 * mm),
        KeepTogether([
            Paragraph("DOCUMENT INTEGRITY AND AUDIT TRAIL", styles["section"]),
            _key_value_table([
                ("Contract hash", contract.contract_hash),
                ("Generated", _timestamp_text(terms.get("generated_at"))),
