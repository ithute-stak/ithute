        ),
        *_clause(
            "19.3",
            "Complete agreement and severability",
            "This agreement, its cost disclosure, repayment schedule and signed annexures form the complete agreement. Amendments must be written and lawfully accepted. "
            "If a clause is invalid, the remaining lawful clauses continue to apply.",
