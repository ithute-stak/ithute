        Paragraph("ANNEXURE A - REPAYMENT SCHEDULE", styles["title"]),
        Paragraph(
            f"Agreement {escape(contract.contract_number)} | Loan {escape(str(terms['loan_reference']))} | Borrower {escape(str(borrower['name']))}",
            styles["subtitle"],
        ),
    ])

    schedule_cards: list[Any] = []
    for row in terms.get("schedule", []):
        number = str(row["number"])
        opening = row.get("opening_balance")
        closing = row.get("closing_balance")
        body = (
            f"Due on <b>{_date_text(row['due_date'])}</b>. The scheduled payment is <b>{_money(row['amount'])}</b>, "
            f"made up of principal <b>{_money(row['principal'])}</b>, interest <b>{_money(row['interest'])}</b> "
            f"and fees <b>{_money(row['fee'])}</b>."
        )
        meta = None
        if opening is not None or closing is not None:
            meta = f"Opening principal {_money(opening)} | Closing principal {_money(closing)}"
        schedule_cards.extend([
            timeline_card(number, f"Instalment {number}", body, meta=meta, status="scheduled", tone="blue"),
