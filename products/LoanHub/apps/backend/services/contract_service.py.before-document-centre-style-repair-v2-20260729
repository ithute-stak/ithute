def _signature_box(title: str, name: str | None, signed_at: Any, method: str | None, styles: dict[str, ParagraphStyle]) -> Table:
    status = "SIGNED" if signed_at else "PENDING"
    status_color = PALE_TEAL if signed_at else LIGHT
    data = [
        [_p(title, styles["table_label"]), _p(status, styles["right"])],
        [_p("Name", styles["table_label"]), _p(name or "________________________________", styles["signature"])],
        [_p("Signature", styles["table_label"]), _p(name if signed_at else "________________________________", styles["signature"])],
        [_p("Date and time", styles["table_label"]), _p(_timestamp_text(signed_at), styles["table_value"])],
        [_p("Method", styles["table_label"]), _p(_enum_text(method) if method else "Wet ink / electronic / OTP", styles["table_value"])],
    ]
    table = Table(data, colWidths=[35 * mm, 50 * mm])
    table.setStyle(TableStyle([
        ("BACKGROUND", (0, 0), (-1, 0), status_color),
        ("GRID", (0, 0), (-1, -1), 0.5, BORDER),
