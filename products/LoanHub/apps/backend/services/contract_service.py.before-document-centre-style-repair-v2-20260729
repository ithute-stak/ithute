        ("TOPPADDING", (0, 0), (-1, -1), 6),
        ("BOTTOMPADDING", (0, 0), (-1, -1), 6),
    ]))
    return table


def _contract_pdf(db: Session, contract: LoanContract) -> bytes:
    """Render the Filizwa-inspired LoanHub agreement with dynamic Lesotho data.

    The clause order follows the uploaded two-page Filizwa agreement, while the
    presentation, key-facts disclosure, repayment schedule, dual-logo branding,
    signatures and audit controls are retained from LoanHub's existing contract.
    Legal wording is deliberately localised to Lesotho rather than copying South
    African statutory references that may not apply to the lender.
    """
    terms = contract.terms_snapshot
    company = terms["company"]
    borrower = terms["borrower"]
    styles = _styles()
    company_signer_person = _person_for_user(db, contract.company_signer_user_id)
    company_signer_name = company_signer_person.full_name if company_signer_person else None

    buffer = BytesIO()
    document = SimpleDocTemplate(
        buffer,
        pagesize=A4,
        rightMargin=18 * mm,
        leftMargin=18 * mm,
        topMargin=38 * mm,
        bottomMargin=21 * mm,
        title=f"Loan Agreement {contract.contract_number}",
        author=f"{company.get('name') or 'Loan company'} via {settings.PRODUCT_NAME}",
        subject="Loan agreement, cost of credit and repayment conditions",
        creator=f"{settings.PRODUCT_NAME} by {settings.DEVELOPER_NAME}",
    )

    story: list[Any] = [
        Paragraph("LOAN AGREEMENT", styles["title"]),
        Paragraph("CONDITIONS OF LOAN, COST OF CREDIT AND REPAYMENT TERMS", styles["subtitle"]),
        _key_value_table([
            ("Agreement number", contract.contract_number),
            ("Loan account", terms["loan_reference"]),
            ("Application reference", terms.get("application_reference") or "Not applicable"),
            ("Agreement date", _date_text(terms.get("agreement_date"))),
            ("Document version", str(contract.version)),
            ("Status", _enum_text(contract.status)),
        ], styles),
        Spacer(1, 3 * mm),
        _two_party_table(terms, styles),
        Spacer(1, 3 * mm),
        _callout(
            "IMPORTANT: Read the full agreement, cost disclosure and repayment schedule before signing. "
            "Do not sign while required information is blank. Ask the lender to explain any term that is unclear.",
            styles,
            background=PALE_BLUE,
        ),
        Paragraph("1. CONDITIONS OF LOAN", styles["section"]),
        _conditions_of_loan_table(terms, styles),
        Paragraph("2. COST ELEMENTS OF THE LOAN", styles["section"]),
        _cost_elements_table(terms, styles),
    ]

    if terms.get("is_top_up"):
        story.extend([
            Spacer(1, 3 * mm),
            _callout(
                f"TOP-UP DISCLOSURE: {_money(terms.get('top_up_settlement_amount'))} is allocated to settle the previous loan. "
                f"The amount made available to the borrower is {_money(terms.get('top_up_cash_amount'))}.",
                styles,
                background=PALE_TEAL,
            ),
        ])

    story.extend([
        Spacer(1, 3 * mm),
        _callout(
            f"LEGAL BASIS: {terms.get('legal_basis') or 'Applicable law of the Kingdom of Lesotho.'}",
            styles,
            background=LIGHT,
        ),
        Spacer(1, 4 * mm),
        Paragraph("LOAN CONDITIONS", styles["title"]),
        Paragraph(
            f"Agreement {escape(contract.contract_number)} | Loan {escape(str(terms['loan_reference']))}",
            styles["subtitle"],
        ),
        *_clause(
            "6",
            "Credit charges and payment schedule",
            "The cost disclosure, Key Facts Statement and repayment schedule form part of this agreement. "
            "They record the approved principal, interest, fees, instalments and payment dates and must be read together with these conditions.",
            styles,
        ),
        *_clause(
            "7",
            "Early settlement",
            "The borrower may settle this agreement at any time by paying the unpaid principal, accrued disclosed interest, "
            "disclosed fees and any other amount permitted by applicable law up to the settlement date. The lender must provide "
            "an early-settlement quotation or account calculation on request.",
            styles,
        ),
        *_clause(
            "8.1",
            "Proposed loan agreement",
            "This document, together with the cost disclosure and repayment schedule, constitutes the proposed loan agreement. "
            "The agreement becomes binding when accepted and signed through the lender's approved process and all approval conditions are met.",
            styles,
        ),
        *_clause(
            "8.2",
            "Inconsistency in disclosed charges",
            "If an inconsistency exists between a pre-agreement quotation, the Key Facts Statement and this agreement, the lower lawful "
            "credit charge applies unless applicable law requires another result. No undisclosed fee or charge may be collected.",
            styles,
        ),
        *_clause(
            "9",
            "Interest rate",
            f"Interest is calculated on the outstanding principal using the approved rate of {_percentage(terms.get('interest_rate'))} "
            f"and the recorded calculation method ({terms.get('calculation_method') or 'approved loan calculation'}). "
            "A rate may change only where this agreement and applicable law permit the change, and only after the borrower receives any required written notice.",
            styles,
        ),
        *_clause(
            "10",
            "Settlement of the loan and payment mandate",
            "The borrower agrees to repay the loan using an approved payment method. Where a bank deduction, salary deduction, debit order, "
            "mobile-money mandate or similar collection instruction is separately authorised, that mandate forms an annexure to this agreement. "
            "A failed third-party collection does not remove the borrower's obligation to pay by the due date.",
            styles,
        ),
        Spacer(1, 2 * mm),
        _bank_details_table(terms, styles),
        *_clause(
            "11",
            "Penalty clause",
            "When a repayment is overdue, the lender may charge only penalty interest, service fees and reasonable recovery costs that were "
            "properly disclosed, agreed and permitted by applicable law. Collection and legal costs may be recovered only through a lawful process.",
            styles,
        ),
        *_clause(
            "12",
            "Lender's right to terminate or enforce",
            "If the borrower defaults on an agreed repayment or commits another material breach, the lender may issue the notices required by law, "
            "terminate or accelerate the agreement where legally permitted, and institute lawful recovery proceedings. Any court judgment or credit-bureau "
            "reporting must follow applicable notice, accuracy and procedural requirements.",
            styles,
        ),
        *_clause(
            "13",
            "Document provided and available",
            "A completed copy of this signed agreement and its repayment schedule must be provided or made securely available to the borrower without charge. "
            "The lender must also make applicable lending rules, complaint information and required notices reasonably accessible.",
            styles,
        ),
        *_clause(
            "14",
            "Conditions, rights and obligations",
            "The borrower and lender agree that their rights and obligations are governed by this agreement, its signed annexures and the mandatory requirements "
            "of the laws of the Kingdom of Lesotho. A contractual term cannot remove a right that the law makes non-waivable.",
            styles,
        ),
        *_clause(
            "15",
            "Account statements",
            "The lender must provide statements at the intervals required by law and on reasonable request. Each statement should show payments, allocations, "
            "arrears, charges and the outstanding balance. A statement fee may be charged only if it was disclosed and is permitted by law.",
            styles,
        ),
        *_clause(
            "16",
            "Administration, insolvency or similar order",
            "The borrower confirms that any current administration, insolvency, debt-relief or similar court process has been disclosed. If such a process begins "
            "after signature, the borrower must notify the lender promptly. The lender may prove or recover its lawful claim only through the procedure allowed by law.",
            styles,
        ),
        *_clause(
            "17",
            "Debt review or repayment arrangement",
            "The borrower confirms that any current debt review, restructuring or repayment arrangement has been disclosed. The borrower should contact the lender "
            "as soon as payment difficulty is expected. Any revised arrangement must be affordable, written and accepted by the parties where required.",
            styles,
        ),
        *_clause(
            "18",
            "Dispute resolution",
            f"The borrower should first raise a dispute with {company.get('name') or 'the lender'} using "
            f"{terms.get('complaints_phone') or 'the recorded telephone number'} or {terms.get('complaints_email') or 'the recorded email address'}. "
            "If the matter is not resolved, the borrower may approach the Central Bank of Lesotho, another competent regulator, an ombudsman where available, "
            "or a court with jurisdiction. This clause does not limit any statutory remedy.",
            styles,
        ),
        Paragraph("19. PRIVACY, NOTICES AND GENERAL TERMS", styles["section"]),
        *_clause(
            "19.1",
            "Privacy and credit reporting",
            "The lender must protect personal information and use or disclose it only for lawful lending, account administration, fraud prevention, compliance, "
            "collection and authorised credit-reporting purposes. Adverse credit information may be reported only after any required notice and accuracy checks.",
