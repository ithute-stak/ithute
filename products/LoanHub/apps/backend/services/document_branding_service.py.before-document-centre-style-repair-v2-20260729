NAVY = colors.HexColor("#0f172a")
BLUE = colors.HexColor("#0b63c9")
MUTED = colors.HexColor("#475569")
BORDER = colors.HexColor("#cbd5e1")
PANEL = colors.HexColor("#f8fafc")

# The system logo is always read from LoanHub's deployed backend assets.
# Company logos are always read from ManagedFile storage for the company that
# owns the document/loan being rendered.
LEFT_LOGO_CATEGORIES = {"company_logo_left", "company_logo", "company_brand_logo"}
RIGHT_LOGO_CATEGORIES = {"company_logo_right", "company_logo_secondary"}


def _asset_path(relative: str) -> Path | None:
    candidate = Path(relative).expanduser()
    if candidate.is_absolute() and candidate.exists():
        return candidate
    root_candidate = Path(__file__).resolve().parents[1] / relative
    return root_candidate if root_candidate.exists() else None


def _system_logo_path() -> Path | None:
    return _asset_path("assets/loanhub-contract-logo.png") or _asset_path(settings.LOANHUB_LOGO_PATH)


def _system_logo_bytes() -> bytes | None:
    path = _system_logo_path()
    if not path:
        return None
    try:
        return path.read_bytes()
    except OSError:
        return None


@dataclass(frozen=True)
class BrandingLogos:
    """Backward-compatible logo-only response used by older PDF code."""

    left_logo: bytes | None
    right_logo: bytes | None


@dataclass(frozen=True)
class CompanyDocumentBranding:
    """Resolved branding for a company-owned LoanHub document.

    `system_logo` is the LoanHub system logo from backend assets.
    `company_logo` is the latest stored company logo from ManagedFile.
    Company text comes from the current LoanCompany record when one is
    available, so regenerated contracts/slips use the company's current public
    identity without hard-coding branding into PDF services.
    """

    system_logo: bytes | None
    company_logo: bytes | None
    company_name: str
    registration_number: str | None
    license_number: str | None
    phone: str | None
    email: str | None
    website: str | None
    address: str | None
    district: str | None

    @property
    def identity_line(self) -> str:
        parts: list[str] = []
        if self.registration_number:
            parts.append(f"Registration No: {self.registration_number}")
        if self.license_number:
            parts.append(f"Licence No: {self.license_number}")
        return "  |  ".join(parts)

    @property
    def contact_line(self) -> str:
        parts: list[str] = []
        if self.phone:
            parts.append(self.phone)
        if self.email:
            parts.append(self.email)
        if self.website:
            parts.append(self.website)
        return "  |  ".join(parts)

    @property
    def address_line(self) -> str:
        parts = [value for value in (self.address, self.district) if value]
        return ", ".join(parts)


def _clean_text(value: object | None) -> str | None:
    text = str(value or "").strip()
    return text or None


def _latest_logo_file(
    db: Session | None,
    company_id: UUID | None,
    categories: set[str],
) -> ManagedFile | None:
    if not db or not company_id:
        return None
    return (
        db.query(ManagedFile)
        .filter(
            ManagedFile.company_id == company_id,
            ManagedFile.is_deleted.is_(False),
            ManagedFile.category.in_(tuple(categories)),
        )
        .order_by(ManagedFile.created_at.desc())
        .first()
    )


def _latest_logo_bytes(
    db: Session | None,
    company_id: UUID | None,
    categories: set[str],
) -> bytes | None:
    file = _latest_logo_file(db, company_id, categories)
    if not file:
        return None
    try:
        return read_file_bytes(file)
    except Exception:
        # Branding must never make a contract/receipt fail to render. A missing
        # or damaged optional logo falls back to a text-only/company-info header.
        return None


def _latest_workspace_logo_asset(
    db: Session | None,
    company_id: UUID | None,
) -> WorkspaceDocumentAsset | None:
    """Resolve the company logo used by Document Studio when no managed right logo exists.

    Document Studio logos are stored separately from ManagedFile branding
    uploads. Keeping this fallback here makes FastAPI loan PDFs, contracts,
    receipts and editable Document Studio exports resolve the same company
    visual instead of silently dropping the right-side logo.
    """
    if not db or not company_id:
        return None
    return (
        db.query(WorkspaceDocumentAsset)
        .filter(
            WorkspaceDocumentAsset.company_id == company_id,
            WorkspaceDocumentAsset.kind == "logo",
            WorkspaceDocumentAsset.is_active.is_(True),
            WorkspaceDocumentAsset.is_default.is_(True),
        )
        .order_by(
            WorkspaceDocumentAsset.updated_at.desc(),
            WorkspaceDocumentAsset.created_at.desc(),
        )
        .first()
    )


def _latest_workspace_logo_bytes(
    db: Session | None,
    company_id: UUID | None,
) -> bytes | None:
    asset = _latest_workspace_logo_asset(db, company_id)
    if not asset:
        return None
    try:
        return asset_image_bytes(asset)
    except Exception:
        # A damaged optional image must never prevent a financial/legal PDF
        # from rendering. The company identity text remains authoritative.
        return None


def _company_logo_bytes(db: Session | None, company_id: UUID | None) -> bytes | None:
    # Priority is deliberate:
    # 1. Company Settings' explicit right/secondary document logo.
    # 2. The company's current default Document Studio logo.
    # 3. Company Settings' primary/legacy company logo.
    #
    # This makes generated loan documents use the same right-side company logo
    # that users see in Document Studio while preserving the explicit company
    # branding upload as the strongest source.
    return (
        _latest_logo_bytes(db, company_id, RIGHT_LOGO_CATEGORIES)
        or _latest_workspace_logo_bytes(db, company_id)
        or _latest_logo_bytes(db, company_id, LEFT_LOGO_CATEGORIES)
    )

def get_company_document_branding(
    db: Session | None,
    company: LoanCompany | Any | None,
) -> CompanyDocumentBranding:
    company_id = getattr(company, "id", None)
    if company_id is not None and not isinstance(company_id, UUID):
        try:
            company_id = UUID(str(company_id))
        except (TypeError, ValueError):
            company_id = None

    return CompanyDocumentBranding(
        system_logo=_system_logo_bytes(),
        company_logo=_company_logo_bytes(db, company_id),
        company_name=_clean_text(getattr(company, "name", None)) or "Loan company",
        registration_number=_clean_text(getattr(company, "registration_number", None)),
        license_number=_clean_text(getattr(company, "license_number", None)),
        phone=_clean_text(getattr(company, "phone", None)),
        email=_clean_text(getattr(company, "email", None)),
        website=_clean_text(getattr(company, "website", None)),
        address=_clean_text(getattr(company, "address", None)),
        district=_clean_text(getattr(company, "district", None)),
    )


def get_company_branding_logos(db: Session | None, company: LoanCompany | None) -> BrandingLogos:
    """Compatibility wrapper for existing callers.

    The left side is the LoanHub system logo. The right side is the current
    company's latest stored logo.
    """

    branding = get_company_document_branding(db, company)
    return BrandingLogos(
        left_logo=branding.system_logo,
        right_logo=branding.company_logo,
    )


def draw_brand_header(
    canvas,
    *,
    db: Session,
    company: LoanCompany | None,
    title: str,
    subtitle: str | None = None,
    document_reference: str | None = None,
    height=A4[1],
    width=A4[0],
) -> None:
    """Draw the shared three-column LoanHub/company document header.

    Layout:
        [LoanHub system logo]   [current company information]   [company logo]

    This helper remains available for reports that use the legacy canvas API;
    contract and receipt services consume the same resolved branding object.
    """

    branding = get_company_document_branding(db, company)
    canvas.saveState()

    if branding.system_logo:
        try:
            canvas.drawImage(
                ImageReader(BytesIO(branding.system_logo)),
                18 * mm,
                height - 24 * mm,
                width=40 * mm,
                height=14 * mm,
                preserveAspectRatio=True,
                anchor="w",
                mask="auto",
            )
        except Exception:
            pass
    else:
        canvas.setFillColor(NAVY)
        canvas.setFont("Helvetica-Bold", 15)
        canvas.drawString(18 * mm, height - 16 * mm, settings.PRODUCT_NAME)

    if branding.company_logo:
        try:
            canvas.drawImage(
                ImageReader(BytesIO(branding.company_logo)),
                width - 54 * mm,
                height - 24 * mm,
                width=36 * mm,
                height=14 * mm,
                preserveAspectRatio=True,
                anchor="e",
                mask="auto",
            )
        except Exception:
            pass

    centre_x = width / 2
    y = height - 11.5 * mm
    canvas.setFillColor(NAVY)
    canvas.setFont("Helvetica-Bold", 9.6)
    canvas.drawCentredString(centre_x, y, branding.company_name[:72])

    y -= 4 * mm
    if branding.identity_line:
        canvas.setFillColor(MUTED)
        canvas.setFont("Helvetica", 7.2)
        canvas.drawCentredString(centre_x, y, branding.identity_line[:100])
        y -= 3.5 * mm

    if branding.contact_line:
        canvas.setFillColor(MUTED)
        canvas.setFont("Helvetica", 6.8)
        canvas.drawCentredString(centre_x, y, branding.contact_line[:112])
        y -= 3.2 * mm

    if branding.address_line:
        canvas.setFillColor(MUTED)
        canvas.setFont("Helvetica", 6.7)
        canvas.drawCentredString(centre_x, y, branding.address_line[:110])

    canvas.setStrokeColor(BLUE)
    canvas.setLineWidth(1.1)
    canvas.line(18 * mm, height - 29 * mm, width - 18 * mm, height - 29 * mm)

    canvas.setFillColor(NAVY)
    canvas.setFont("Helvetica-Bold", 17)
    canvas.drawString(18 * mm, height - 40 * mm, title[:80])
    if subtitle:
        canvas.setFillColor(MUTED)
        canvas.setFont("Helvetica", 8.2)
        canvas.drawString(18 * mm, height - 45 * mm, subtitle[:110])
    if document_reference:
        canvas.setFillColor(MUTED)
        canvas.setFont("Helvetica", 6.7)
        canvas.drawRightString(width - 18 * mm, height - 45 * mm, str(document_reference)[:90])
    canvas.restoreState()


def draw_brand_footer(canvas, doc, *, reference_text: str, note_text: str | None = None, width=A4[0]) -> None:
    canvas.saveState()
    canvas.setStrokeColor(BORDER)
    canvas.setLineWidth(0.6)
    canvas.line(18 * mm, 14 * mm, width - 18 * mm, 14 * mm)
    canvas.setFillColor(MUTED)
    canvas.setFont("Helvetica", 6.8)
    canvas.drawString(18 * mm, 9.5 * mm, reference_text[:88])
    if note_text:
        canvas.drawCentredString(width / 2, 9.5 * mm, note_text[:88])
    canvas.drawRightString(width - 18 * mm, 9.5 * mm, f"Page {doc.page}")
    canvas.restoreState()


def company_branding_payload(db: Session, company: LoanCompany) -> dict[str, Any]:
    left = _latest_logo_file(db, company.id, LEFT_LOGO_CATEGORIES)
    right = _latest_logo_file(db, company.id, RIGHT_LOGO_CATEGORIES | LEFT_LOGO_CATEGORIES)
    return {
        "company_id": str(company.id),
        "left_logo_file_id": str(left.id) if left else None,
        "right_logo_file_id": str(right.id) if right else None,
        "left_logo_download_url": f"/files/{left.id}/download" if left else None,
        "right_logo_download_url": f"/files/{right.id}/download" if right else None,
    }
