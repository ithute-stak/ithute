done [label="Loan completed",fillcolor="#dff7ed"];
fail [label="Pending/failed - investigate",fillcolor="#fee9e9"];
selected->approve->disb->provider; provider->schedule [label="Yes"]; provider->fail [label="No"]; schedule->active->repay->inbound->confirm; confirm->allocate [label="Yes"]; confirm->fail [label="No"]; allocate->account->complete; complete->done [label="Yes"]; complete->active [label="No"];
}