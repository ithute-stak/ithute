digraph G { rankdir=LR; graph [bgcolor="transparent", fontname="DejaVu Sans", nodesep=0.35, ranksep=0.55, pad=0.2]; node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, color="#b9c8d3", fillcolor="#ffffff", fontcolor="#0d2942", margin="0.14,0.09"]; edge [fontname="DejaVu Sans", fontsize=9, color="#658093", fontcolor="#526c7e", arrowsize=0.75];
clock [shape=oval,label="00:00 Africa/Maseru"];
lock [shape=diamond,label="Acquire PostgreSQL
advisory lock?"];
skip [label="Another worker is running - exit"];
requests [label="Expire eligible requests and offers"];
subs [label="Expire subscriptions"];
overdue [label="Mark overdue instalments and loans"];
complete [label="Reconcile completed loans"];
period [label="Calculate previous day/week/month/year"];
reports [label="Generate platform, company, and branch
PDF + CSV reports"];
files [label="Save reports in managed media"];
audit [label="Write run summary and audit evidence"];
clock->lock; lock->skip [label="No"]; lock->requests [label="Yes"]; requests->subs->overdue->complete->period->reports->files->audit;
}