digraph G {
 graph [rankdir=LR,bgcolor="white",pad=0.25,nodesep=0.45,ranksep=0.55];
 node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontsize=10,color="#d1d5db",fillcolor="#f8fafc"];
 edge [color="#64748b",arrowsize=0.7];
 user[label="Borrower or company user"];
 dock[label="One vertical floating dock\nQuery | Chat | Assistant",fillcolor="#eff6ff",color="#2563eb"];
 query[label="Query Centre\nSupport, payment, feature, technical"];
 owner[label="Platform owner\nReview, respond, update status",fillcolor="#f0fdf4",color="#16a34a"];
 bot[label="Role-aware LoanHub assistant\nGuidance and navigation"];
 chat[label="Tenant-aware realtime chat"];
 user->dock;
 dock->query->owner;
 dock->bot;
 dock->chat;
}
