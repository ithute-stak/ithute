{
    email {$TLS_EMAIL}
}

(security_headers) {
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(self), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' wss: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
}

{$WWW_DOMAIN} {
    redir https://{$APP_DOMAIN}{uri} permanent
}

{$APP_DOMAIN} {
    encode zstd gzip
    import security_headers

    reverse_proxy frontend:3000

    log {
        output stdout
        format console
    }
}

{$API_DOMAIN} {
    encode zstd gzip
    import security_headers

    request_body {
        max_size 30MB
    }

    reverse_proxy backend:8000

    log {
        output stdout
        format console
    }
}

{$SANDBOX_APP_DOMAIN} {
    encode zstd gzip
    import security_headers

    header X-Robots-Tag "noindex, nofollow, noarchive"
    reverse_proxy sandbox_frontend:3000

    log {
        output stdout
        format console
    }
}

{$SANDBOX_API_DOMAIN} {
    encode zstd gzip
    import security_headers

    header X-Robots-Tag "noindex, nofollow, noarchive"
    request_body {
        max_size 30MB
    }

    reverse_proxy sandbox_backend:8000

    log {
        output stdout
        format console
    }
}

# Mailbox-DNS shares this VPS but does not own ports 80/443. LoanHub Caddy is
# attached to the existing Mailbox-DNS application network as the single TLS
# edge and forwards each Ithute hostname to Mailbox-DNS's nginx gateway. Nginx
# preserves host-aware routing for the public site, panel, API and groupware
# without exposing the Mailbox backend or groupware ports publicly.
ithute.co.ls {
    encode zstd gzip
    import security_headers
    request_body {
        max_size 25MB
    }
    reverse_proxy nginx:80
    log {
        output stdout
        format console
    }
}

www.ithute.co.ls {
    import security_headers
    redir https://ithute.co.ls{uri} permanent
}

panel.ithute.co.ls {
    encode zstd gzip
    import security_headers
    request_body {
        max_size 25MB
    }
    reverse_proxy nginx:80
    log {
        output stdout
        format console
    }
}

api.ithute.co.ls {
    encode zstd gzip
    import security_headers
    request_body {
        max_size 25MB
    }
    reverse_proxy nginx:80
    log {
        output stdout
        format console
    }
}

groupware.ithute.co.ls {
    encode zstd gzip
    import security_headers
    request_body {
        max_size 25MB
    }
    reverse_proxy nginx:80
    log {
        output stdout
        format console
    }
}

# Caddy obtains and renews a public certificate for the mail hostname. Mailbox-
# DNS securely copies that certificate into Postfix/Dovecot; HTTP requests to
# the mail hostname are intentionally not an application surface.
mail.ithute.co.ls {
    import security_headers
    respond 204
}
