map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server_tokens off;
gzip on;
gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:ITHUTE_SSL:20m;
ssl_session_timeout 10m;

add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(self), geolocation=()" always;
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' wss: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

# Local container health only. Public traffic is handled by the named hosts below.
server {
    listen 80 default_server;
    server_name _;

    location = /__edge_health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 444;
    }
}

# HTTP-01 validation and HTTPS redirect for every hostname owned by this edge.
server {
    listen 80;
    server_name
        ${APP_DOMAIN}
        ${API_DOMAIN}
        ${WWW_DOMAIN}
        ${SANDBOX_APP_DOMAIN}
        ${SANDBOX_API_DOMAIN}
        ithute.co.ls
        www.ithute.co.ls
        panel.ithute.co.ls
        api.ithute.co.ls
        auth.ithute.co.ls
        push.ithute.co.ls
        realtime.ithute.co.ls
        tutor.ithute.co.ls
        groupware.ithute.co.ls
        pay.ithute.co.ls
        api.pay.ithute.co.ls
        portal.pay.ithute.co.ls
        mail.ithute.co.ls;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
        default_type text/plain;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

# LoanHub canonical web application.
server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/loanhub-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/loanhub-edge/privkey.pem;
    client_max_body_size 30m;

    location / {
        proxy_pass http://frontend:3000;
        include /etc/nginx/snippets/proxy-common.conf;
    }
}

# LoanHub canonical API.
server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/loanhub-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/loanhub-edge/privkey.pem;
    client_max_body_size 30m;

    location / {
        proxy_pass http://backend:8000;
        include /etc/nginx/snippets/proxy-common.conf;
    }
}

# LoanHub www permanently redirects to the canonical application hostname.
server {
    listen 443 ssl;
    http2 on;
    server_name ${WWW_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/loanhub-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/loanhub-edge/privkey.pem;

    return 308 https://${APP_DOMAIN}$request_uri;
}

# LoanHub sandbox application and API stay isolated on the sandbox network.
server {
    listen 443 ssl;
    http2 on;
    server_name ${SANDBOX_APP_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/loanhub-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/loanhub-edge/privkey.pem;
    client_max_body_size 30m;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    location / {
        proxy_pass http://sandbox_frontend:3000;
        include /etc/nginx/snippets/proxy-common.conf;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SANDBOX_API_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/loanhub-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/loanhub-edge/privkey.pem;
    client_max_body_size 30m;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    location / {
        proxy_pass http://sandbox_backend:8000;
        include /etc/nginx/snippets/proxy-common.conf;
    }
}

# The Ithute platform and product hostnames continue through the existing
# Mailbox-DNS gateway. It remains the host-aware application router; this Nginx
# instance replaces only Caddy's public TLS/port-80/443 responsibility.
server {
    listen 443 ssl;
    http2 on;
    server_name
        ithute.co.ls
        panel.ithute.co.ls
        api.ithute.co.ls
        auth.ithute.co.ls
        push.ithute.co.ls
        realtime.ithute.co.ls
        tutor.ithute.co.ls
        groupware.ithute.co.ls
        pay.ithute.co.ls
        api.pay.ithute.co.ls
        portal.pay.ithute.co.ls;
    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;
    client_max_body_size 30m;

    location / {
        proxy_pass http://nginx:80;
        include /etc/nginx/snippets/proxy-common.conf;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name www.ithute.co.ls;
    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;

    return 308 https://ithute.co.ls$request_uri;
}

# HTTPS on the mail hostname exists only to retain a complete public TLS identity.
# The same certificate is deployed into Postfix and Dovecot by the production
# edge workflow for SMTP submission and IMAPS.
server {
    listen 443 ssl;
    http2 on;
    server_name mail.ithute.co.ls;
    ssl_certificate /etc/letsencrypt/live/ithute-edge/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ithute-edge/privkey.pem;

    return 204;
}
