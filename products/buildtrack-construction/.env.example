# BuildTrack local-development environment example.
#
# No .env file is required for `docker compose up --build`; compose.yaml has
# replaceable local defaults. Copy this file to .env only when you want to
# override them. Production uses the isolated root docker-compose.buildtrack.yml
# contract and protected runtime secrets instead of these development values.

COMPOSE_PROJECT_NAME=buildtrack
ENVIRONMENT=development
APP_TIMEZONE=Africa/Maseru
PUBLIC_APP_URL=http://localhost:3004
CORS_ORIGINS=http://localhost:3004

DB_NAME=buildtrack
DB_USER=buildtrack
DB_PASSWORD=buildtrack-local-dev-only
REDIS_URL=redis://redis:6379/0

NEXT_PUBLIC_API_URL=/api/v1
BUILDTRACK_BACKEND_URL=http://backend:8000/api/v1
BUILDTRACK_IMAGE_TAG=local
WEB_CONCURRENCY=2
