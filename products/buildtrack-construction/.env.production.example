# Nthane Brothers Construction Management System
# Production values are reconciled into the shared Ithute VPS .env by
# scripts/buildtrack-sync-env.py. Never commit real passwords or client secrets.

ITHUTE_BUILDTRACK_IMAGE_TAG=replace-with-validated-commit-sha
ITHUTE_BUILDTRACK_PUBLIC_URL=https://nbro.ithute.co.ls
ITHUTE_BUILDTRACK_OIDC_REDIRECT_URI=https://nbro.ithute.co.ls/api/v1/access/oidc/callback
ITHUTE_BUILDTRACK_SUPERADMIN_EMAIL=justy@ithute.co.ls
ITHUTE_BUILDTRACK_DB_NAME=buildtrack
ITHUTE_BUILDTRACK_DB_USER=buildtrack
ITHUTE_BUILDTRACK_DB_PASSWORD=replace-with-generated-production-secret
ITHUTE_BUILDTRACK_PUSH_SERVICE_CLIENT_SECRET=replace-with-generated-service-secret
ITHUTE_BUILDTRACK_FRONTEND_PORT=3204
ITHUTE_BUILDTRACK_BACKEND_PORT=8204
ITHUTE_BUILDTRACK_RATE_LIMIT_PER_MINUTE=120

# Shared platform contract
ITHUTE_AUTH_ISSUER=https://auth.ithute.co.ls
# client id: buildtrack-construction
# redirect: https://nbro.ithute.co.ls/api/v1/access/oidc/callback
# Push/Realtime user + service client: buildtrack-construction
