# Ithute Pay Bridge local/sandbox environment
ENVIRONMENT=development
DEBUG=true
PUBLIC_URL=http://localhost:8081
PUBLIC_APP_URL=http://localhost:8081
PUBLIC_API_URL=http://localhost:8081

DB_NAME=paybridge
DB_USER=paybridge
DB_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD

SECRET_KEY=CHANGE_THIS_LONG_RANDOM_SECRET
DATA_ENCRYPTION_KEY=CHANGE_THIS_DIFFERENT_LONG_RANDOM_SECRET
COOKIE_SAMESITE=lax

REDIS_URL=redis://redis:6379/0

# Central !thute Auth migration. Client id is fixed to ithute-pay.
ITHUTE_AUTH_ENABLED=false
ITHUTE_AUTH_LEGACY_LOGIN_ENABLED=true
ITHUTE_AUTH_ISSUER=https://auth.ithute.co.ls
ITHUTE_AUTH_AUDIENCE=ithute-pay
ITHUTE_AUTH_JWKS_URL=https://auth.ithute.co.ls/.well-known/jwks.json
ITHUTE_AUTH_REDIRECT_URI=http://localhost:8081/api/v1/auth/ithute/callback
ITHUTE_AUTH_HTTP_TIMEOUT_SECONDS=10

# Central !thute Push. Use the same runtime-only secret configured for
# ithute-pay in central Auth AUTH_SERVICE_CLIENT_SECRETS_JSON.
ITHUTE_PUSH_ENABLED=false
ITHUTE_PUSH_URL=https://push.ithute.co.ls
ITHUTE_PUSH_SERVICE_CLIENT_SECRET=CHANGE_THIS_TO_MATCH_CENTRAL_AUTH_SERVICE_SECRET
ITHUTE_PUSH_HTTP_TIMEOUT_SECONDS=10

# Temporary migration admin. Keep a strong password until all required admins
# have linked central identities; then disable local login in a controlled rollout.
AUTO_CREATE_PLATFORM_ADMIN=true
BOOTSTRAP_ADMIN_EMAIL=ithute.pay@itpay.co.ls
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_THIS_STRONG_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_FULL_NAME=Ithute Pay Bridge Administrator

SANDBOX_TEST_LAB_ENABLED=true
MPESA_ENABLED=false
MPESA_MODE=simulator
MPESA_ENVIRONMENT=sandbox
MPESA_HOST=https://openapi.m-pesa.com
MPESA_MARKET=vodacomLES
MPESA_COUNTRY=LES
MPESA_CURRENCY=LSL
MPESA_SERVICE_PROVIDER_CODE=000000
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_ORIGIN=*
MPESA_REQUEST_TIMEOUT_SECONDS=60
