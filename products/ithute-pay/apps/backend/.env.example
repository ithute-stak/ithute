ENVIRONMENT=development
DEBUG=true
EXPOSE_ERROR_DETAILS=false
APP_TIMEZONE=Africa/Maseru
PRODUCT_NAME=Ithute Pay
DEVELOPER_NAME=Ithute Solutions
VERSION=1.0.0
API_V1_PREFIX=/api/v1

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
FRONTEND_PORT=3001
PUBLIC_APP_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:8001
PORTAL_APP_URL=http://localhost:3001/portal
VPS_PUBLIC_URL=http://169.255.58.185:8081

# Canonical production origins:
# PUBLIC_APP_URL=https://pay.ithute.co.ls
# PUBLIC_API_URL=https://api.pay.ithute.co.ls
# PORTAL_APP_URL=https://portal.pay.ithute.co.ls

DATABASE_URL=postgresql+psycopg://paybridge:paybridge@localhost:5432/paybridge
DB_HOST=localhost
DB_PORT=5432
DB_USER=paybridge
DB_PASSWORD=paybridge
DB_NAME=paybridge

CORS_ORIGINS=http://localhost:3001,http://169.255.58.185:8081,https://pay.ithute.co.ls,https://portal.pay.ithute.co.ls
TRUSTED_HOSTS=localhost,127.0.0.1,169.255.58.185,testserver,pay.ithute.co.ls,api.pay.ithute.co.ls,portal.pay.ithute.co.ls

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-with-a-long-random-secret
DATA_ENCRYPTION_KEY=change-me-with-a-different-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=14
WEBSOCKET_SESSION_TTL_SECONDS=90
COOKIE_SAMESITE=lax
# Leave blank on localhost. For the three production Ithute Pay subdomains use .pay.ithute.co.ls.
COOKIE_DOMAIN=
MAX_LOGIN_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# Central !thute identity. Keep the local login enabled while existing Ithute Pay
# users link their accounts; disable it only after migration is verified.
ITHUTE_AUTH_ENABLED=false
ITHUTE_AUTH_LEGACY_LOGIN_ENABLED=true
ITHUTE_AUTH_ISSUER=https://auth.ithute.co.ls
ITHUTE_AUTH_AUDIENCE=ithute-pay
ITHUTE_AUTH_JWKS_URL=https://auth.ithute.co.ls/.well-known/jwks.json
# Local Docker callback: http://localhost:8081/api/v1/auth/ithute/callback
# Canonical production callback: https://pay.ithute.co.ls/api/v1/auth/ithute/callback
# The production value must be registered exactly in central Auth.
ITHUTE_AUTH_REDIRECT_URI=
ITHUTE_AUTH_HTTP_TIMEOUT_SECONDS=10

# Central !thute Push. The service secret must match the runtime-only
# AUTH_SERVICE_CLIENT_SECRETS_JSON entry for client id "ithute-pay".
ITHUTE_PUSH_ENABLED=false
ITHUTE_PUSH_URL=https://push.ithute.co.ls
ITHUTE_PUSH_SERVICE_CLIENT_SECRET=
ITHUTE_PUSH_HTTP_TIMEOUT_SECONDS=10

API_SIGNATURE_MAX_AGE_SECONDS=300
API_SIGNATURE_REQUIRED_BY_DEFAULT=false
WEBHOOK_SIGNING_CLOCK_TOLERANCE_SECONDS=300
WEBHOOK_MAX_ATTEMPTS=12
PROVIDER_CALLBACK_TOKEN=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
PUBLIC_RATE_LIMIT_PER_MINUTE=60
REDIS_URL=redis://localhost:6379/0
# Retained for rolling-upgrade compatibility with existing workers.
REDIS_REALTIME_CHANNEL=ithute-pay-bridge:realtime

# On API startup, create this platform super admin only when no active super admin exists.
AUTO_CREATE_PLATFORM_ADMIN=true
BOOTSTRAP_ADMIN_EMAIL=ithute.pay@itpay.co.ls
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
BOOTSTRAP_ADMIN_FULL_NAME=Ithute Pay Administrator
DEFAULT_CURRENCY=LSL
DEFAULT_COUNTRY=LES

# M-Pesa values below are bootstrap/fallback settings only. Runtime environment
# switching and live credentials are managed in gateway_provider_configurations
# from Dashboard -> Providers. Sandbox is seeded automatically and defaults to
# simulator mode; never put production credentials in the frontend.
#
# The shortcode/origin/timeout values below reproduce the previously working
# Ithute/Vodacom Lesotho sandbox integration. They are a project compatibility
# profile, not production credentials or a universal M-Pesa contract.
MPESA_KNOWN_GOOD_SANDBOX_PROFILE_ENABLED=true
MPESA_ENABLED=false
MPESA_MODE=simulator
MPESA_ENVIRONMENT=sandbox
MPESA_HOST=https://openapi.m-pesa.com
MPESA_MARKET=vodacomLES
MPESA_COUNTRY=LES
MPESA_CURRENCY=LSL
MPESA_SERVICE_PROVIDER_CODE=000000
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_ORIGIN=*
MPESA_SESSION_ACTIVATION_SECONDS=30
MPESA_REQUEST_TIMEOUT_SECONDS=60

# Accounting policy: provider/gateway processing fees are retained by default on reversal.
REFUND_GATEWAY_FEES_ON_REVERSAL=false

# Admin dashboard simulator test lab. Never sends live provider traffic.
SANDBOX_TEST_LAB_ENABLED=true
