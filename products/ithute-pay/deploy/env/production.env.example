# Ithute Pay Bridge production example
IPB_IMAGE=ghcr.io/<owner>/ithute-pay-bridge:<commit-sha>
ENVIRONMENT=production
DEBUG=false
EXPOSE_ERROR_DETAILS=false

DB_NAME=paybridge
DB_USER=paybridge
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_DATABASE_PASSWORD
REDIS_URL=redis://redis:6379/0

SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_PRODUCTION_SECRET
DATA_ENCRYPTION_KEY=CHANGE_THIS_TO_A_DIFFERENT_LONG_RANDOM_PRODUCTION_SECRET

# Canonical public surfaces.
PUBLIC_APP_URL=https://pay.ithute.co.ls
PUBLIC_API_URL=https://api.pay.ithute.co.ls
PORTAL_APP_URL=https://portal.pay.ithute.co.ls
CORS_ORIGINS=https://pay.ithute.co.ls,https://portal.pay.ithute.co.ls
TRUSTED_HOSTS=pay.ithute.co.ls,api.pay.ithute.co.ls,portal.pay.ithute.co.ls,localhost,127.0.0.1
AUTH_COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Keep human SSO cookies host-only on pay.ithute.co.ls. The consumer portal uses
# sandbox application API keys and the public API does not need dashboard cookies.
COOKIE_DOMAIN=

# Central !thute identity. The exact callback must be allowlisted by Auth.
ITHUTE_AUTH_ENABLED=true
ITHUTE_AUTH_LEGACY_LOGIN_ENABLED=true
ITHUTE_AUTH_ISSUER=https://auth.ithute.co.ls
ITHUTE_AUTH_AUDIENCE=ithute-pay
ITHUTE_AUTH_JWKS_URL=https://auth.ithute.co.ls/.well-known/jwks.json
ITHUTE_AUTH_REDIRECT_URI=https://pay.ithute.co.ls/api/v1/auth/ithute/callback
ITHUTE_AUTH_HTTP_TIMEOUT_SECONDS=10

# Central !thute Push. Keep the service secret runtime-only.
ITHUTE_PUSH_ENABLED=true
ITHUTE_PUSH_URL=https://push.ithute.co.ls
ITHUTE_PUSH_SERVICE_CLIENT_SECRET=CHANGE_THIS_TO_RUNTIME_SERVICE_SECRET
ITHUTE_PUSH_HTTP_TIMEOUT_SECONDS=10

RUN_MIGRATIONS_ON_START=true
AUTO_CREATE_PLATFORM_ADMIN=true
BOOTSTRAP_ADMIN_EMAIL=ithute.pay@itpay.co.ls
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_INITIAL_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_FULL_NAME=Ithute Pay Bridge Administrator

# The built-in administrator lab remains separate from the consumer portal.
# VCL/partner users use https://portal.pay.ithute.co.ls with ipb_test_ application keys.
SANDBOX_TEST_LAB_ENABLED=true

MPESA_ENABLED=true
MPESA_MODE=live
MPESA_ENVIRONMENT=production
MPESA_MARKET=vodacomLES
MPESA_COUNTRY=LES
MPESA_CURRENCY=LSL
MPESA_SERVICE_PROVIDER_CODE=CHANGE_THIS
MPESA_API_KEY=CHANGE_THIS
# Use the public key shown by the M-Pesa portal for THIS production application/environment.
# Do not copy a sandbox public key into production; provider keys may differ by environment.
MPESA_PUBLIC_KEY=CHANGE_THIS
# Must match an Origin registered on the M-Pesa application. Provider callback/API traffic
# belongs to the public API host; the consumer portal never receives provider credentials.
MPESA_ORIGIN=https://api.pay.ithute.co.ls

# Optional trusted-proxy/shared-secret protection for provider callback routes.
# The M-Pesa OpenAPI callback contract supplied with this project does not document
# an X-Provider-Callback-Token header. Leave this blank unless Vodacom or a trusted
# reverse proxy in front of PayBridge is configured to inject the same value.
PROVIDER_CALLBACK_TOKEN=
