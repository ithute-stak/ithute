# NBros product-owned infrastructure
NBROS_DB_NAME=nbros
NBROS_DB_USER=nbros
NBROS_DB_PASSWORD=replace-with-a-long-random-nbros-db-password
NBROS_DATABASE_URL=postgresql+psycopg://nbros:replace-with-a-long-random-nbros-db-password@db:5432/nbros
NBROS_REDIS_URL=redis://redis:6379/0

# Public product identity
NBROS_PUBLIC_URL=https://nbro.ithute.co.ls
NBROS_FRONTEND_PORT=3203
NBROS_BACKEND_PORT=8203

# Central Ithute identity. NBros never stores passwords.
NBROS_AUTH_ISSUER=https://auth.ithute.co.ls
NBROS_AUTH_AUDIENCE=nbros
NBROS_AUTH_JWKS_URL=https://auth.ithute.co.ls/.well-known/jwks.json
NBROS_AUTH_CLIENT_ID=nbros
NBROS_OIDC_REDIRECT_URI=https://nbro.ithute.co.ls/api/auth/oidc/callback
NBROS_COOKIE_SECURE=true
NBROS_BOOTSTRAP_ADMIN_EMAIL=justy@ithute.co.ls
NBROS_AUTH_SERVICE_TOKEN_URL=https://auth.ithute.co.ls/v1/auth/service-token

# Central Ithute realtime/WebSocket service.
NBROS_REALTIME_PUBLIC_URL=https://realtime.ithute.co.ls
NBROS_REALTIME_WS_URL=wss://realtime.ithute.co.ls/v1/ws
# Runtime secret only. Use the same value for nbros in Central Auth AUTH_SERVICE_CLIENT_SECRETS_JSON.
NBROS_REALTIME_SERVICE_CLIENT_SECRET=replace-with-a-long-random-runtime-service-secret
NBROS_REALTIME_PUBLISH_ENABLED=true

# Continuous Fleet evaluator.
NBROS_FLEET_MONITOR_INTERVAL_SECONDS=60
NBROS_FLEET_MONITOR_LOCK_SECONDS=120
